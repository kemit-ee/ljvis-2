{
    "content": [
        {{#each logs}}
        {
            "eventId": "{{this.eventId}}",
            "eventType": "{{this.eventType}}",
            "eventCategory": "{{this.eventCategory}}",
            "actorName": {{#if this.actorName}}{{{json this.actorName}}}{{else}}""{{/if}},
            "actorPersonalCode": "{{this.actorPersonalCodeHash}}",
            "description": {{#if this.description}}{{{json this.description}}}{{else}}""{{/if}},
            "logContent": "{{this.logContent}}",
            "createdAt": "{{this.createdAt}}",
            "createdBy": "{{this.createdBy}}"
        }{{#unless @last}},{{/unless}}
        {{/each}}
    ]
}
