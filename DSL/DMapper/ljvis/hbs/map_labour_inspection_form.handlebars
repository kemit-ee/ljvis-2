{{#with forms.[0]}}
{
        "id": "{{this.id}}",
        "formNumber": "{{this.formNumber}}",
        "version": {{this.version}},
        "status": "{{this.status}}",
        "revision": {{#if this.revision}}{{this.revision}}{{else}}null{{/if}},
        "inspectorName": {{#if this.inspectorName}}{{{json this.inspectorName}}}{{else}}""{{/if}},
        "inspectionDate": "{{this.inspectionDate}}",
        "externalInspectionId": {{#if this.externalInspectionId}}{{{json this.externalInspectionId}}}{{else}}null{{/if}},
        "inspectionType": "{{this.inspectionType}}",
        "companyName": {{#if this.companyName}}{{{json this.companyName}}}{{else}}""{{/if}},
        "companyRegCode": {{#if this.companyRegCode}}{{{json this.companyRegCode}}}{{else}}""{{/if}},
        "vehicleCount": {{#if this.vehicleCount}}{{this.vehicleCount}}{{else}}null{{/if}},
        "totalDriversCount": {{#if this.totalDriversCount}}{{this.totalDriversCount}}{{else}}null{{/if}},
        "controlsMatrix": {{{this.controlsMatrix}}},
        "prescriptionComposed": {{this.prescriptionComposed}},
        "punishedPersonIdCode": {{#if this.punishedPersonIdCode}}{{{json this.punishedPersonIdCode}}}{{else}}null{{/if}},
        "punishedPersonFirstName": {{#if this.punishedPersonFirstName}}{{{json this.punishedPersonFirstName}}}{{else}}null{{/if}},
        "punishedPersonLastName": {{#if this.punishedPersonLastName}}{{{json this.punishedPersonLastName}}}{{else}}null{{/if}},
        "proceedingReferenceNumber": {{#if this.proceedingReferenceNumber}}{{{json this.proceedingReferenceNumber}}}{{else}}null{{/if}},
        "enforcementDecision": {{#if this.enforcementDecision}}{{{json this.enforcementDecision}}}{{else}}null{{/if}},
        "proceedingClosureBasis": {{#if this.proceedingClosureBasis}}{{{json this.proceedingClosureBasis}}}{{else}}null{{/if}},
        "violations": {{{this.violations}}},
        "createdBy": "{{this.createdBy}}"
}
{{/with}}
