{
    "content": [
        {{#each classifiers}}
        {
            "id": "{{this.id}}",
            "code": "{{this.code}}",
            "name": {{#if this.name}}{{{json this.name}}}{{else}}""{{/if}},
            "description": {{#if this.description}}{{{json this.description}}}{{else}}""{{/if}}
        }{{#unless @last}},{{/unless}}
        {{/each}}
    ],
    "total": {{#with classifiers.[0]}}{{total}}{{else}}0{{/with}}
}
