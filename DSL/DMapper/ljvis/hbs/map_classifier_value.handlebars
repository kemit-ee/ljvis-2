{
    "content": [
        {{#each classifierValues}}
        {
            "classifierId": "{{this.classifierId}}",
            "classifierValueId": "{{this.classifierValueId}}",
            "classifierCode": "{{this.classifierCode}}",
            "code": "{{this.code}}",
            "name": "{{this.name}}",
            "validFrom": "{{this.validFrom}}",
            "validUntil": "{{this.validUntil}}",
            "isValid": "{{this.isValid}}"
        }{{#unless @last}},{{/unless}}
        {{/each}}
    ],
    "total": {{#with classifierValues.[0]}}{{total}}{{else}}0{{/with}}
}