[
    {{#each users}}
    {
        "id": "{{this.id}}",
        "firstName": {{#if this.firstName}}{{{json this.firstName}}}{{else}}""{{/if}},
        "lastName": {{#if this.lastName}}{{{json this.lastName}}}{{else}}""{{/if}},
        "personalCode": {{#if this.personalCode}}{{{json this.personalCode}}}{{else}}""{{/if}},
        "organisationId": "{{this.organisationId}}",
        "organisationName": {{#if this.organisationName}}{{{json this.organisationName}}}{{else}}""{{/if}},
        "email": {{#if this.email}}{{{json this.email}}}{{else}}""{{/if}},
        "phone": {{#if this.phone}}{{{json this.phone}}}{{else}}""{{/if}},
        "structuralUnitName": {{#if this.structuralUnit}}{{{json this.structuralUnit}}}{{else}}""{{/if}},
        "jobTitleName": {{#if this.jobTitle}}{{{json this.jobTitle}}}{{else}}""{{/if}},
        "accessStart": "{{this.accessStart}}",
        "accessEnd": "{{this.accessEnd}}",
        "status": "{{this.status}}"
    }{{#unless @last}},{{/unless}}
    {{/each}}
]
