        "residenceRegion": {{#if this.residenceRegion}}"{{this.residenceRegion}}"{{else}}null{{/if}},
        "residenceCity": {{#if this.residenceCity}}"{{this.residenceCity}}"{{else}}null{{/if}},
        "residenceAddressLine": {{#if this.residenceAddressLine}}"{{this.residenceAddressLine}}"{{else}}null{{/if}},
        "residencePostalCode": {{#if this.residencePostalCode}}"{{this.residencePostalCode}}"{{else}}null{{/if}},
        "interruptionReason": {{#if this.interruptionReason}}{{{json this.interruptionReason}}}{{else}}null{{/if}},
        "legalBases": {{#if this.legalBases}}{{{this.legalBases}}}{{else}}[]{{/if}},
        "terminationCondition": {{#if this.terminationCondition}}{{{json this.terminationCondition}}}{{else}}null{{/if}},
        "personApplications": {{#if this.personApplications}}{{{json this.personApplications}}}{{else}}null{{/if}},
