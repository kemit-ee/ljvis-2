{{#with forms.[0]}}
{
        "id": "{{this.id}}",
        "formNumber": "{{this.formNumber}}",
        "version": {{this.version}},
        "status": "{{this.status}}",
        "revision": {{#if this.revision}}{{this.revision}}{{else}}null{{/if}},
        "personalCode": {{#if this.personalCode}}{{{json this.personalCode}}}{{else}}""{{/if}},
        "firstName": {{#if this.firstName}}{{{json this.firstName}}}{{else}}""{{/if}},
        "lastName": {{#if this.lastName}}{{{json this.lastName}}}{{else}}""{{/if}},
        "legacyImport": {{#if this.legacyImport}}true{{else}}false{{/if}},
        "dateOfBirth": {{#if this.dateOfBirth}}"{{this.dateOfBirth}}"{{else}}null{{/if}},
        "placeOfBirth": {{#if this.placeOfBirth}}{{{json this.placeOfBirth}}}{{else}}null{{/if}},
        "certificateNumber": {{#if this.certificateNumber}}{{{json this.certificateNumber}}}{{else}}""{{/if}},
        "certificateIssueDate": {{#if this.certificateIssueDate}}"{{this.certificateIssueDate}}"{{else}}null{{/if}},
        "certificateCountryCode": "{{this.certificateCountryCode}}",
        "fitnessStatus": "{{this.fitnessStatus}}",
        "unfitFromDate": {{#if this.unfitFromDate}}"{{this.unfitFromDate}}"{{else}}null{{/if}},
        "unfitUntilDate": {{#if this.unfitUntilDate}}"{{this.unfitUntilDate}}"{{else}}null{{/if}},
        "createdBy": "{{this.createdBy}}"
}
{{/with}}
