{
  "totalFound": {{totalFound}},
  "data": [
    {{#each companies}}
    {
      "registryCode": "{{this.ariregistri_kood}}",
      "companyName": {{#if this.evnimi}}{{{json this.evnimi}}}{{else}}""{{/if}},
      {{#if this.oiguslik_vorm}}"legalForm": {{{json this.oiguslik_vorm}}},{{/if}}
      "status": "{{this.staatus}}",
      "statusText": {{#if this.staatus_tekstina}}{{{json this.staatus_tekstina}}}{{else}}""{{/if}},
      "address": {{#if this.evaadressid.aadress_ads__ads_normaliseeritud_taisaadress}}{{{json this.evaadressid.aadress_ads__ads_normaliseeritud_taisaadress}}}{{else}}""{{/if}},
      "street": {{#if this.evaadressid.asukoht_ettevotja_aadressis}}{{{json this.evaadressid.asukoht_ettevotja_aadressis}}}{{else}}""{{/if}},
      "city": {{#if this.evaadressid.asukoha_ehak_tekstina}}{{{json this.evaadressid.asukoha_ehak_tekstina}}}{{else}}""{{/if}},
      "postalCode": "{{this.evaadressid.indeks_ettevotja_aadressis}}"
    }{{#unless @last}},{{/unless}}
    {{/each}}
  ]
}
