# Copy to .env, chmod 600 .env. This file is sourced by bash: quote values
# containing spaces, $, # etc. Prefer single quotes for passwords.
# Python 3.11+; python -m pip install -r requirements.txt BEFORE the run.

SOURCE_MSSQL_HOST=
SOURCE_MSSQL_PORT=1433
SOURCE_MSSQL_USER=
SOURCE_MSSQL_PASSWORD=
SOURCE_MSSQL_DB=
# SNAPSHOT requires ALLOW_SNAPSHOT_ISOLATION ON on the restored source.
# SERIALIZABLE is an alternative on a frozen copy; may hold read locks.
SOURCE_MSSQL_ISOLATION=SNAPSHOT
SOURCE_MSSQL_QUERY_TIMEOUT=300
EXTRACT_BATCH_SIZE=2000

# required | absent-confirmed. Never use absence to ignore inaccessible data.
RAVENDB_MODE=required
RAVENDB_ABSENCE_REASON=
SOURCE_RAVENDB_URL=
SOURCE_RAVENDB_DATABASE=
SOURCE_RAVENDB_V1_COLLECTION=JobInspections
SOURCE_RAVENDB_V2_COLLECTION=JobInspectionV2s
SOURCE_RAVENDB_TIMEOUT=120
# Optional PEM client certificate/private key and server CA bundle.
SOURCE_RAVENDB_CERT=
SOURCE_RAVENDB_KEY=
SOURCE_RAVENDB_CA=

TARGET_PG_HOST=
TARGET_PG_PORT=5432
TARGET_PG_DB=
TARGET_PG_USER=
TARGET_PG_PASSWORD=
TARGET_PG_SSLMODE=verify-full
# libpq standard variables may also be used: PGSSLROOTCERT, PGSSLCERT,
# PGSSLKEY, PGPASSFILE. No secrets are printed by the coordinator.

# Last THREE YEARS, with an explicit frozen lower bound per cutover date.
# Example for a cutover on 2026-09-22. Update for the actual agreed cutover.
CUTOFF=2023-09-22
# Identifies the exact coordinated SQL Server/RavenDB backup pair.
SOURCE_LABEL=
# Set yes only after the source copy is frozen/restored; no concurrent writers.
SOURCE_FROZEN=
# Set yes ONLY on a disposable rehearsal target. Needed by --rehearsal.
TARGET_DISPOSABLE=
CONNECT_TIMEOUT=30
# Optional unique UUID; empty = a fresh UUID. Existing IDs cannot be reused.
RUN_ID=
# Empty/unset uses DSL/migration/runs. Do not commit reports with real data.
# MIGRATION_LOG_DIR=/secure/migration-runs
# PYTHON=/path/to/venv/bin/python
# MIGRATION_ENV_FILE=/secure/migration.env
