# Citizen-facing endpoints use a TARA JWT session (representation claims:
# personalCode/activeRole/activeRegistryCode/representedCompanies), not the
# officer session that templates/check-user-authority expects (which requires
# a users.user_account row). override_ancestors: true so the parent GET/v1/.guard
# (officer-only) doesn't reject citizen requests before they even reach here.
declaration:
  override_ancestors: true

authenticate:
  template: "templates/citizen-authority"
  requestType: GET
  headers:
    cookie: ${incoming.headers.cookie}
  result: authority_result

check_authority_result:
  switch:
    - condition: ${authority_result !== "false"}
      next: guard_success
  next: guard_fail

guard_success:
  return: "success"
  status: 200
  next: end

guard_fail:
  return: "unauthorized"
  status: 403
  next: end
