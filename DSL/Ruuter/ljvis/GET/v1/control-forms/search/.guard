authenticate:
  template: "templates/check-user-authority"
  requestType: GET
  headers:
    cookie: ${incoming.headers.cookie}
  result: u
  next: check

check:
  switch:
    - condition: ${u.permissions != null && (u.permissions.includes('control_form.view_unpublished') || u.permissions.includes('compound_form.read') || u.permissions.includes('foreign_violation_form.read') || u.permissions.includes('labour_inspection_form.read') || u.permissions.includes('good_repute_form.read') || u.permissions.includes('adr_form.read') || u.permissions.includes('sp_driver_form.read') || u.permissions.includes('sp_teammate_form.read') || u.permissions.includes('vehicle_technical_form.read') || u.permissions.includes('trailer_technical_form.read') || u.permissions.includes('transport_interruption_form.read'))}
      next: allow
  next: deny

allow:
  status: 200
  return: "ok"
  next: end

deny:
  status: 403
  return: "forbidden"
  next: end
