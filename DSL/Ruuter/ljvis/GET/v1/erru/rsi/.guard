# RSI needs rsi.read, not ctud.read — override the parent GET/v1/erru/.guard
# (which is ctud-specific) instead of stacking on top of it. Protects every
# GET file directly under erru/rsi/ (get.yml, and search.yml in a later stage) —
# they all need the same permission, so no further nesting is required here.
# rsi.list is deliberately NOT a separate permission (see docs/permissions-matrix.md
# §1 rsi.read) — folded into rsi.read for consistency with ctud.read/cgr.read.
declaration:
  override_ancestors: true

authenticate:
  template: "templates/check-user-authority"
  requestType: GET
  headers:
    cookie: ${incoming.headers.cookie}
  result: u
  next: check

check:
  switch:
    - condition: ${u.permissions != null && u.permissions.includes('rsi.read')}
      next: allow
  next: deny

allow:
  status: 200
  return: "ok"
  next: end

deny:
  status: 403
  return: "forbidden"
  next: end
