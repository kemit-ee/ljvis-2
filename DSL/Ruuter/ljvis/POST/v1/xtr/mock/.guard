# Permissive guard for the DEV/CI-ONLY XTR mock.
#
# The parent POST/.guard requires a valid LJVIS user cookie. The mock stands in
# for XTR / the X-tee security server, and the consuming DSLs call it exactly
# the way they will call the real XTR in production — i.e. server-to-server,
# WITHOUT forwarding the caller's session cookie (citizen TARA sessions could
# never satisfy the officer guard anyway). Forwarding a user cookie to an
# external endpoint would be wrong, so instead of weakening the callers this
# narrower guard lets the stub be reached.
#
# Safe because the mock is unreachable in production: LJVIS_XTR points at the
# real XTR there (constants.ini ConfigMap), and nothing else references this
# path. As defence-in-depth, the repo-root .dockerignore excludes this
# directory from every Docker build context, so it cannot ship in a built
# image even if the constant were misconfigured; local/CI compose files
# restore it via a bind-mount of the whole DSL/Ruuter/ljvis tree.
#
# override_ancestors is required: Rust Ruuter stacks ancestor guards by
# default, so without this the parent POST/.guard cookie check would still run
# and reject the unauthenticated mock call with 403.
declaration:
  override_ancestors: true

allow_mock:
  return: "success"
  status: 200
  next: end
