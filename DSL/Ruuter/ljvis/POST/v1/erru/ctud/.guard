# Send requires only ctud.send; override ancestors so ctud.create (from
# POST/v1/erru/.guard) is not also required. The mock guard (POST/v1/erru/mock/.guard)
# already uses override_ancestors for the same reason.
declaration:
  override_ancestors: true

authenticate:
  template: "templates/check-user-authority"
  requestType: GET
  headers:
    cookie: ${incoming.headers.cookie}
  result: u
  next: check

check:
  switch:
    - condition: ${u.permissions != null && u.permissions.includes('ctud.send')}
      next: allow
  next: deny

allow:
  status: 200
  return: "ok"
  next: end

deny:
  status: 403
  return: "forbidden"
  next: end
