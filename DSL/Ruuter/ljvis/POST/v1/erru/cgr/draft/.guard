# Draft management (create) needs cgr.create, isolated from the sibling
# POST/v1/erru/cgr/send.yml + resend.yml (cgr.send) — those need their OWN,
# different permission, so they cannot share a guard with this directory even
# though both live under erru/cgr/. override_ancestors also skips the unrelated
# POST/v1/erru/.guard (ctud.create), which would otherwise stack.
declaration:
  override_ancestors: true

authenticate:
  template: "templates/check-user-authority"
  requestType: GET
  headers:
    cookie: ${incoming.headers.cookie}
  result: u
  next: check

check:
  switch:
    - condition: ${u.permissions != null && u.permissions.includes('cgr.create')}
      next: allow
  next: deny

allow:
  status: 200
  return: "ok"
  next: end

deny:
  status: 403
  return: "forbidden"
  next: end
