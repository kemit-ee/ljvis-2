# Draft management (save = create OR revise, single unified endpoint per LJVIS2-147)
# needs rsi.create, isolated from the sibling POST/v1/erru/rsi/send.yml (rsi.send,
# a later stage) — those need their OWN, different permission, so they cannot share
# a guard with this directory even though both will live under erru/rsi/.
# override_ancestors also skips the unrelated POST/v1/erru/.guard (ctud.create).
declaration:
  override_ancestors: true

authenticate:
  template: "templates/check-user-authority"
  requestType: GET
  headers:
    cookie: ${incoming.headers.cookie}
  result: u
  next: check

check:
  switch:
    - condition: ${u.permissions != null && u.permissions.includes('rsi.create')}
      next: allow
  next: deny

allow:
  status: 200
  return: "ok"
  next: end

deny:
  status: 403
  return: "forbidden"
  next: end
