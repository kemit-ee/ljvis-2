# Composing/saving a response draft to an incoming NCR message needs ncr.respond,
# isolated from the sibling POST/v1/erru/ncr/request/.guard (ncr.create). override_ancestors
# also skips the unrelated POST/v1/erru/.guard (ctud.create).
declaration:
  override_ancestors: true

authenticate:
  template: "templates/check-user-authority"
  requestType: GET
  headers:
    cookie: ${incoming.headers.cookie}
  result: u
  next: check

check:
  switch:
    - condition: ${u.permissions != null && u.permissions.includes('ncr.respond')}
      next: allow
  next: deny

allow:
  status: 200
  return: "ok"
  next: end

deny:
  status: 403
  return: "forbidden"
  next: end
