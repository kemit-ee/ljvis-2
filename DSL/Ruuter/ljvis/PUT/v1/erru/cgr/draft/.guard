# Revising a CGR draft also requires cgr.create (no separate "edit" permission
# per LJVIS2-138). override_ancestors skips the unrelated PUT/v1/erru/.guard
# (ctud.create).
declaration:
  override_ancestors: true

authenticate:
  template: "templates/check-user-authority"
  requestType: GET
  headers:
    cookie: ${incoming.headers.cookie}
  result: u
  next: check

check:
  switch:
    - condition: ${u.permissions != null && u.permissions.includes('cgr.create')}
      next: allow
  next: deny

allow:
  status: 200
  return: "ok"
  next: end

deny:
  status: 403
  return: "forbidden"
  next: end
