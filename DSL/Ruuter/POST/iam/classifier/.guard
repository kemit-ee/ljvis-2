# .guard — ligipääsukontroll klassifikaatori endpointidele

checkJwt:
  call: http.post
  args:
    url: "[#TIM_URL]/jwt/verify"
    body:
      jwt: ${incoming.headers.Authorization}
  result: jwt
  next: checkPermission

checkPermission:
  switch:
    - condition: "${jwt.response.body.permissions.includes('classifier.list')}"
      next: proceed
    - condition: "${jwt.response.body.permissions.includes('classifier.read')}"
      next: proceed
    - condition: "${jwt.response.body.permissions.includes('classifier.edit')}"
      next: proceed
  next: forbidden

forbidden:
  return: "Access denied"
  status: 403
  next: end

proceed:
  next: end
