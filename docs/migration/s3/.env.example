# Kopeeri failiks .env ja taida.

# 1. Failikaust (LJVIS1 Paths.FormDocuments)
FILES_ROOT=D:\LJVIS\FormDocuments

# 2. Juba migreeritud LJVIS2 andmebaas
PG_HOST=localhost
PG_PORT=5432
PG_DB=ljvis2_proov
PG_USER=ljvis2
PG_PASSWORD=

# 3. S3
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=protokollid
