# Kopeeri see fail nimega .env ja taida kuus rida.

# 1. Tee LJVIS1 varukoopiani (.bak)
BACKUP_FILE=/tee/ljvis.bak

# 2. Sihtandmebaas: TUHI PostgreSQL andmebaas, mis on selle prooviks eraldi
#    loodud. Kasutajal peab olema oigus luua skeeme ja tabeleid.
#    Skript keeldub tootamast, kui andmebaas ei ole tuhi.
PG_HOST=localhost
PG_PORT=5432
PG_DB=ljvis2_proov
PG_USER=ljvis2
PG_PASSWORD=

# Rohkem ei ole vaja midagi taita. Allpool olev on erijuhtudeks; kui
# migratsioon tootab, ara neid ridu puutu.

# Ajapiir. Tuhjana migreeritakse viimased kolm aastat tanasest.
# CUTOFF=2023-09-29

# TLS. Vaikimisi krupteeritakse uhendus, kui server seda pakub.
# Neid kahte rida laheb vaja ainult siis, kui teie PostgreSQL nouab
# sertifikaadi kontrolli.
# PG_SSLMODE=verify-full
# PG_SSLROOTCERT=/tee/root.crt
