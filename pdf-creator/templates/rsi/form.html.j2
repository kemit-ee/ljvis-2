{% extends 'shared/base.html.j2' %}{% block body %}
<div class="source">Liiklevate tarbesõidukite tehnokontrolli teade</div>
<h1>{{ title }}</h1><div class="number">{{ number }}</div>
<h2>Teate andmed</h2>
<table><tr><td>{{ field('Teate esitanud liikmesriik', r.get('rsiFrom','')) }}</td><td>{{ field('Sihtliikmesriik',r.get('rsiTo','')) }}</td></tr>
<tr><td colspan="2">{{ field('Teate esitanud pädev asutus',r.get('originatingAuthority','')) }}</td></tr></table>
<table><tr><td colspan="2">{{ field('Otsitaotluse üksikasjad',r.get('requestPurpose','')) }}</td></tr></table>
<h2>Sõiduki andmed</h2>
<table><tr><td>{{ field('Kategooria',r.get('vehicleCategory','')) }}</td><td>{{ field('Registreerimisnumber',r.get('vehicleRegistrationNumber','')) }}</td></tr>
<tr><td>{{ field('Registreerimisriik',r.get('vehicleRegistrationCountry','')) }}</td><td>{{ field('VIN-kood',r.get('vehicleIdentificationNumber','')) }}</td></tr>
<tr><td colspan="2">{{ field('Läbisõidumõõdiku näit',r.get('odometerReading','')) }}</td></tr></table>
<h2>Juhi andmed</h2><table><tr><td>{{ field('Eesnimi',r.get('driverFirstName','')) }}</td><td>{{ field('Perekonnanimi',r.get('driverFamilyName','')) }}</td></tr>
<tr><td>{{ field('Juhiloa number',r.get('driverLicenceNumber','')) }}</td><td>{{ field('Juhiloa riik',r.get('driverLicenceCountry','')) }}</td></tr></table>
<h2>Veoettevõtja või omaniku andmed</h2><table><tr><td>{{ box(holder_type == 'transport_undertaking') }} Veoettevõtja</td><td>{{ box(holder_type == 'owner') }} Omanik</td></tr>
<tr><td>{{ field('Ettevõtja/omaniku nimi',holder_name) }}</td><td>{{ field('Ühenduse tegevusloa number',holder_licence) }}</td></tr>
<tr><td>{{ field('Aadress',holder_address) }}</td><td>{{ field('Linn',holder_city) }}</td></tr>
<tr><td>{{ field('Riik',holder_country) }}</td><td>{{ field('Sihtnumber',holder_postcode) }}</td></tr></table>
<h2>Liiklevate sõidukite tehnokontrolli andmed</h2><table>
<tr><td colspan="2">{{ field('Liiklevate sõidukite tehnokontrolli tunnus',r.get('inspectionIdentifier','')) }}</td></tr>
<tr><td>{{ field('Kontrolli koht',r.get('inspectionLocation','')) }}</td><td>{{ field('Kuupäev ja kellaaeg',inspection_date ~ ' ' ~ inspection_time) }}</td></tr>
<tr><td colspan="2">{{ field('Kontrolliasutus või kontrollija nimi',r.get('inspectionAuthorityOrName','')) }}</td></tr></table>
<h2>Tehnokontrolli tulemused</h2><table><tr><td>{{ box(r.get('inspectionPassed') == true) }} Vastab nõuetele</td><td>{{ box(r.get('ptiRequested') == true) }} On vaja teha korraline tehnoülevaatus</td><td>{{ box(r.get('vehicleProhibitionOrRestriction') == true) }} Keelamine või piiramine</td></tr></table>
{% if legacy %}<h2>Kontrollitud punkt</h2><p class="small">Teade on koostatud enne ERRU mitteläbimise põhjuste klassifikaatori kasutuselevõttu — kuvatakse riiklikud tehnokontrolli koodid.</p><table class="small"><thead><tr><th>Punkt</th><th style="width:22mm">Kontrollitud</th><th style="width:26mm">Ei vasta nõuetele</th><th>Rikked</th></tr></thead><tbody>
{% for item in legacy_rows %}<tr><td>{{ item.name }}</td><td class="center">{{ box(item.status in ('checked', 'non_compliant')) }}</td><td class="center">{{ box(item.status == 'non_compliant') }}</td><td>{% for d in item.defects %}{{ d.get('defectCode','') }} ({{ d.get('severity','') }}){% if not loop.last %}<br>{% endif %}{% endfor %}</td></tr>{% endfor %}
</tbody></table>{% else %}
<h2>Kontrollitud punkt</h2><table class="small"><thead><tr><th>Punkt</th><th style="width:22mm" class="center">Kontrollitud</th><th style="width:26mm" class="center">Ei vasta nõuetele</th></tr></thead><tbody>
{% for item in parts %}<tr><td>{{ item.name }}</td><td class="center">{{ box(item.status in ('checked', 'non_compliant')) }}</td><td class="center">{{ box(item.status == 'non_compliant') }}</td></tr>{% endfor %}
</tbody></table>
<h2>Kontrollitud punkti andmed</h2><table class="reason-table"><colgroup><col style="width:26%"><col><col style="width:12mm"><col style="width:12mm"><col style="width:12mm"></colgroup>
<thead><tr><th>Aspekt</th><th>Tehnoülevaatuse mitteläbimise põhjused</th><th class="center">Vähe&shy;oluline</th><th class="center">Oluline</th><th class="center">Ohtlik</th></tr></thead><tbody>
{% for row in reason_rows %}{% if row.kind == 'heading' %}<tr class="{{ 'item' if row.item else 'group' }}"><td colspan="5">{{ row.text }}</td></tr>
{% else %}<tr>{% if row.aspect is none %}<td colspan="2">{{ row.label }}</td>{% else %}{% if row.rowspan %}<td rowspan="{{ row.rowspan }}">{{ row.aspect }}</td>{% endif %}<td>{{ row.label }}</td>{% endif %}{% for b in row.boxes %}<td class="center">{% if b.allowed %}{{ box(b.checked) }}{% endif %}</td>{% endfor %}</tr>
{% endif %}{% endfor %}</tbody></table>{% endif %}{% endblock %}
