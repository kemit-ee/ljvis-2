{% extends 'shared/base.html.j2' %}{% block body %}
<h1>TEEL VEOSE- VÕI SÕITJATEVEDU TEGEVA SÕIDUKI DOKUMENTIDE, MASSI, TELJEKOORMUSE,<br>MÕÕTMETE, VEOAUTO TEEKASUTUSTASU NING JUHI SÕIDU- JA PUHKEAJA NÕUETE KONTROLLKAART</h1><div class="number">{{ number }}</div>
<table><tr><td>{{ field('Kontrolli koht',fields.place) }}</td><td style="width:20%">{{ field('Kuupäev',fields.date) }}</td><td style="width:18%">{{ field('Kellaaeg',fields.time) }}</td></tr><tr><td>{{ field('Mootorsõiduk: riigi tunnus, mark ja mudel',fields.country + ' ' + fields.vehicle) }}</td><td colspan="2">{{ field('Registreerimismärk',fields.reg) }}</td></tr><tr><td colspan="3">{{ field('Haagis(ed)',fields.trailers) }}</td></tr><tr><td colspan="3">Sõiduki kategooria<div class="value">{{ category_choices() }}</div></td></tr><tr><td>{{ field('Vedaja nimi, registrikood ja aadress',fields.company + '\n' + fields.companyAddress) }}</td><td colspan="2">{{ field('Mootorsõidukijuhi ees- ja perekonnanimi, kodakondsus, isikukood või sünniaeg',fields.driver + '\n' + fields.citizenship) }}{{ field('Teise juhi andmed',fields.secondDriver) }}</td></tr><tr><td>Veo liik: {{ box(f.get('transportType') == 'Sõitjatevedu') }} Sõitjatevedu {{ box(f.get('transportType') == 'Veosevedu') }} Veosevedu<br>{{ box(empty_run) }} Tühisõit<br>{{ box(f.get('transportNature') == 'Tasuline') }} Tasuline {{ box(f.get('transportNature') == 'Oma kulul') }} Oma kulul<br>{{ box(exempt) }} Tegevusloa nõudest vabastatud vedu</td><td colspan="2">{% if blank %}{% for r in transport_class_catalog %}{{ box() }} {{ r.name }}<br>{% endfor %}{% else %}{{ field('Veoliigi täpsustus',transport_classes|join('\n')) }}{% endif %}{{ field('Ühenduse tegevusloa kinnitatud ärakirja / tõestatud koopia number',fields.licence) }}</td></tr></table>
<h2>Dokumentide või õiguse kontroll</h2><table><thead><tr><th>Dokument / õigus</th><th style="width:23%">Rikkumise kood</th><th style="width:16%">Raskusaste</th></tr></thead><tbody>{% for row in document_checks %}<tr><td>{{ row.name }}</td><td>{{ row.code }}</td><td>{{ row.severity }}</td></tr>{% else %}{% for r in document_categories %}<tr><td>{{ r.name }}</td><td></td><td></td></tr>{% endfor %}{% endfor %}</tbody></table>
<h2>Muud dokumendid</h2><table class="small"><thead><tr><th style="width:42%">Dokument</th><th>Nõuetekohane</th><th>Ei vasta nõuetele</th><th>Puudub</th><th style="width:22%">Märkus</th></tr></thead><tbody>{% for d in other_documents %}<tr><td>{{ d.name }}</td>{% for state in ['NOUETEKOHANE','EI_VASTA_NOUETELE','PUUDUB'] %}<td class="center">{{ box(d.result == state) }}</td>{% endfor %}<td>{{ d.notes }}</td></tr>{% endfor %}</tbody></table>
{% if cabotage %}<h2>Kabotaažveo rikkumised</h2><table>{% for r in cabotage %}<tr><td>{{ r.name }}</td><td>{{ r.severity }}</td></tr>{% endfor %}</table>{% endif %}
<section class="newpage"><h1>Sõidu- ja puhkeaeg, mass ja mõõtmed</h1><div class="number">{{ number }}</div>
<table><tr><td colspan="3">Sõidu- ja puhkeaja nõuete täitmine:<br>{{ box(f.get('spApplicability') == 'RAKENDATAKSE') }} Rakendatakse {{ box(f.get('spApplicability') == 'EI_RAKENDATA') }} Ei rakendata {{ box(f.get('spApplicability') == 'EI_KONTROLLITUD') }} Ei kontrollitud</td></tr><tr><td colspan="3">{{ field('Sõidumeeriku liik',tachograph) }}{% if blank %}{% for code,name in tachograph_options %}{{ box() }} {{ name }} {% endfor %}<br>{% endif %}{{ box(not_downloaded) }} Sõidumeeriku andmeid ei laaditud alla</td></tr><tr><td>{{ field('Kontrollitud päevade arv',f.get('checkedDaysCount','')) }}</td><td>{{ field('Nendest juhi tööpäevade arv',f.get('workDaysCount','')) }}</td><td>{{ field('Muu tegevuse päevade arv',f.get('otherActivityDaysCount','')) }}</td></tr></table>
<h2>Auto või autorongi massi, pikkuse, laiuse, kõrguse ja teljekoormuse mõõtmine</h2><p>{{ box(mass_noncompliant) }} Mass või mõõtmed ei vasta nõuetele</p>
<table><thead><tr><th>Mõõtmise liik</th><th>Telje nr</th><th>Tegelik väärtus</th><th>Lubatud väärtus</th><th>Ületamine</th></tr></thead><tbody>{% for m in measurements %}<tr><td>{{ m.get('measurementType','') }}</td><td>{{ m.get('axleNumber','') }}</td><td>{{ m.get('actualValue','') }}</td><td>{{ m.get('allowedValue','') }}</td><td>{{ m.get('excessValue','') }}</td></tr>{% else %}{% for name in ['Mass','Pikkus','Laius','Kõrgus','Teljekoormus'] %}<tr><td>{{ name }}</td><td class="space"></td><td></td><td></td><td></td></tr>{% endfor %}{% endfor %}</tbody></table>
<table><tr><td>ATP kokkuleppe nõuetele vastavus<br>{{ box(atp) }} Tuvastatud rikkumine</td><td>{{ field('Märkus',atp_notes) }}</td></tr><tr><td>Veoauto teekasutustasu</td><td><div class="value">{{ road_tax }}</div></td></tr></table>
<h2>Märkused ja lisatud failid</h2><div class="notes">{{ fields.notes }}</div>
<table><tr><td>{{ field('Kontrolli tulemus',fields.result) }}</td><td>{{ field('Lisameede',additional_measure) }}</td></tr><tr><td colspan="2">{{ field('Menetluse liik ja viitenumber / väärteoasja number',fields.proceeding) }}</td></tr><tr><td class="signature">{{ field('Kontrollija ees- ja perekonnanimi, ametinimetus ja asutus ning allkiri',fields.inspector) }}</td><td class="signature">Mootorsõidukijuhi või teise juhi allkiri</td></tr></table>
</section>
<section class="newpage"><h1>Sõidu- ja puhkeaja rikkumised</h1><div class="number">{{ number }}</div>
{% for group in violation_groups %}<h2>{{ group.title }}</h2><table class="small"><thead><tr><th style="width:17%">Kood</th><th>Rikkumise liik</th><th style="width:15%">Raskusaste</th><th style="width:15%">Tuvastatud</th></tr></thead><tbody>{% for r in group.rows %}<tr><td>{{ r.code }}</td><td>{{ r.name }}</td><td>{{ r.severity }}</td><td class="center">{{ box(r.detected) }}</td></tr>{% else %}<tr><td class="space"></td><td></td><td></td><td>{{ box() }}</td></tr>{% endfor %}</tbody></table>{% endfor %}
<p class="small">MSI — kõige raskem rikkumine; VSI — väga raske rikkumine; SI — raske rikkumine; MI — väike rikkumine.</p></section>
{% if blank %}<section class="newpage"><h1>Rikkumiste kontroll-loend</h1><p class="small">Projekti DRIVING_VIOLATION klassifikaatori väljavõte. Märgi tuvastatud rikkumine.</p><table class="small"><thead><tr><th style="width:17%">Kood / õiguslik alus</th><th>Rikkumine ja vahemik</th><th style="width:12%">Raskus</th><th style="width:9%">Märge</th></tr></thead><tbody>{% for r in violation_catalog %}<tr><td>{{ r.code }}<br>{{ r.article }}</td><td>{{ r.name }}<br>{{ r.threshold }}</td><td>{{ r.severity }}</td><td class="center">{{ box() }}</td></tr>{% endfor %}</tbody></table></section>{% endif %}
{% endblock %}
