{% extends 'shared/base.html.j2' %}{% block body %}
<div class="number">{{ number }}</div><h1>{{ title }}</h1>
<table><tr><th colspan="2" class="section">Veokorraldusjuht</th></tr><tr><td>{{ field('Ees- ja perekonnanimi',([f.firstName,f.lastName]|select|join(' '))) }}</td><td>{{ field('Isikukood',f.personalCode) }}</td></tr><tr><td>{{ field('Sünniaeg',dt(f.dateOfBirth)) }}</td><td>{{ field('Sünnikoht',f.placeOfBirth) }}</td></tr><tr><th colspan="2" class="section">Ametipädevuse tunnistus</th></tr><tr><td>{{ field('Tunnistuse number',f.certificateNumber) }}</td><td>{{ field('Väljastamise kuupäev ja riik',([dt(f.certificateIssueDate),label('countries',f.certificateCountryCode)]|select|join(', '))) }}</td></tr><tr><th colspan="2" class="section">Hea maine nõudele vastavus</th></tr><tr><td colspan="2">{{ field('Staatus',label('fitnessStatuses',f.fitnessStatus)) }}</td></tr><tr><td>{{ field('Mittevastav alates',dt(f.unfitFromDate)) }}</td><td>{{ field('Mittevastav kuni',dt(f.unfitUntilDate)) }}</td></tr><tr><td class="signature">Otsuse tegija nimi ja allkiri</td><td class="signature">Kuupäev</td></tr></table>
{% endblock %}
