{% extends 'shared/base.html.j2' %}{% block body %}
<h1>{{ title }}{% if number %} nr {{ number }}{% endif %}</h1>
<table><tr><td colspan="3" class="center">{{ field('Otsuse teinud asutus',fields.header) }}</td></tr><tr><td>{{ field('Koostamise kuupäev',fields.date) }}</td><td colspan="2">{{ field('Autoveo katkestamise koht',fields.place) }}</td></tr><tr><td colspan="2">{{ field('Teenistusaste, ees- ja perekonnanimi',fields.inspector) }}</td><td class="signature">Allkiri</td></tr><tr><th colspan="3" class="center">Riikliku järelevalve teostamise käigus</th></tr><tr><td colspan="3">{{ field('Autojuht: ees- ja perekonnanimi, isikukood või sünniaeg',fields.driver) }}</td></tr><tr><td colspan="3">{{ field('Elukoht',fields.residence) }}</td></tr><tr><td>Poolt juhitud mootorsõiduk</td><td>{{ field('Mark ja mudel',fields.vehicle) }}</td><td>{{ field('Registreerimismärk',fields.reg) }}</td></tr><tr><td>Haagis(ed)</td><td colspan="2">{{ field('Mark, mudel ja registreerimismärk',fields.trailers) }}</td></tr><tr><td>Veoseveo korraldaja</td><td colspan="2">{{ field('Nimi ja aadress',fields.company + '\n' + fields.companyAddress) }}</td></tr><tr><th colspan="3" class="center">Otsustas</th></tr><tr><td>Katkestada autojuhi</td><td colspan="2"><span class="value">{{ fields.driverName }}</span></td></tr><tr><td>{{ field('Autovedu alates (kuupäev)',fields.startDate) }}</td><td>{{ field('Kellaaeg',fields.startTime) }}</td><td>{{ field('Kuni',fields.end) }}</td></tr><tr><td colspan="3">Õiguslik alus ja katkestamise põhjus<div class="notes">{{ legal_bases|join('\n') }}
{{ fields.reason }}</div></td></tr><tr><th colspan="3">Autoveo katkestamise lõppemise tingimus</th></tr><tr><td colspan="3"><div class="notes">{{ fields.termination }}</div></td></tr><tr><td colspan="3" class="small">Autoveo katkestamise otsuse võib vaidlustada haldusmenetluse seaduses sätestatud korras 30 päeva jooksul Politsei- ja Piirivalveametile. Isikul, kelle vaie jäi rahuldamata või kelle õigusi vaidemenetluses rikuti, on õigus pöörduda halduskohtumenetluse seadustikus sätestatud tingimustel ja korras kaebusega halduskohtusse.</td></tr><tr><td colspan="3">Isiku taotlused<div class="notes">{{ fields.applications }}</div></td></tr><tr><th colspan="3">Olen autoveo katkestamise otsuse kätte saanud.</th></tr><tr><td>{{ field('Ees- ja perekonnanimi',fields.driverName) }}</td><td>{{ field('Kättesaamise kuupäev',fields.receiptDate) }}</td><td class="signature">Allkiri</td></tr></table>
{% endblock %}
