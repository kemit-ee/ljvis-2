{% extends 'shared/base.html.j2' %}{% block body %}<div class="tram-card">
<div class="number">{{ number }}</div><h1>{{ title }}</h1>
<table><tr><th colspan="4" class="section">Kontroll</th></tr><tr><td colspan="2">{{ field('Koht',fields.place) }}</td><td>{{ field('Kuupäev',fields.date) }}</td><td>{{ field('Kellaaeg',fields.time) }}</td></tr><tr><th colspan="4" class="section">Sõiduk ja veoettevõtja</th></tr><tr><td>{{ field('Registreerimismärk',fields.vehicleReg) }}</td><td>{{ field('Mark ja mudel',fields.vehicle) }}</td><td colspan="2">{{ field('VIN',fields.vehicleVin) }}</td></tr><tr><td colspan="2">{{ field('Veoettevõtja',fields.company) }}</td><td colspan="2">{{ field('Tegevusloa või koopia number',fields.licence) }}</td></tr><tr><td colspan="4">{{ field('Aadress',fields.companyAddress) }}</td></tr><tr><th colspan="4" class="section">Sõidukijuht ja vedu</th></tr><tr><td colspan="2">{{ field('Sõidukijuht',drivers[0].display if drivers else '') }}</td><td>{{ box(yes(f.driverNotApplicable)) }} Ei ole asjakohane</td><td>{{ field('Veoliik',f.transportType) }}</td></tr><tr><td>{{ field('Veo laad',f.transportNature) }}</td><td>{{ box(yes(f.transportEmptyRun)) }} Tühisõit</td><td>{{ field('Liini number',f.liiniNumber) }}</td><td>{{ field('Liini nimetus',f.liiniNimetus) }}</td></tr></table>
<h2>Dokumendi- ja õiguse kontroll</h2><table class="small"><thead><tr><th>Dokument või õigus</th><th>Rikkumise kood</th><th>Raskusaste / tulemus</th></tr></thead><tbody>{% for r in document_checks %}<tr><td>{{ r.documentName or r.level2Name or r.documentCode }}</td><td>{{ r.violationCode or r.level3Code }}</td><td>{{ r.severityCode or r.level3Name }}</td></tr>{% endfor %}{% for r in other_documents %}<tr><td>{{ r.documentName or r.documentCode }}</td><td>{{ r.violationCode or '' }}</td><td>{{ r.result or r.severityCode or '' }}</td></tr>{% endfor %}{% if not document_checks and not other_documents %}<tr><td class="space"></td><td></td><td></td></tr>{% endif %}</tbody></table>
<h2>Rikkumised</h2>{% for group in violation_groups %}{% if blank or group.rows %}<h3>{{ group.title }}</h3><table class="small"><thead><tr><th>Kood</th><th>Raskusaste</th><th>Avastatud</th></tr></thead><tbody>{% if group.rows %}{% for r in group.rows %}<tr><td>{{ r.violationCode }}</td><td>{{ r.severityCode }}</td><td>{{ box(yes(r.isDetected)) }}</td></tr>{% endfor %}{% else %}<tr><td class="space"></td><td></td><td></td></tr>{% endif %}</tbody></table>{% endif %}{% endfor %}
<h2>Kontrolli tulemus</h2><table><tr><td>{{ field('Tulemus',label('results',f.resultType)) }}</td><td>{{ field('Lisameede',label('results',f.additionalMeasure)) }}</td><td>{{ field('Menetluse liik ja viide',([f.proceedingType,f.proceedingReferenceNumber]|select|join(' / '))) }}</td></tr><tr><td colspan="2">{{ field('Märkused',fields.notes) }}</td><td>{{ field('Kontrollija',fields.inspector) }}</td></tr></table></div>
{% endblock %}
