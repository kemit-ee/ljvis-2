<!doctype html><html lang="et"><head><meta charset="utf-8"><title>{{ title }} {{ number }}</title>
<style>
@page { size:A4; margin:12mm; @bottom-right { content:counter(page) " / " counter(pages); font:8pt serif; } }
body { margin:0; color:#000; font:9pt/1.18 "Liberation Serif", "Times New Roman", serif; }
* { box-sizing:border-box; } h1 { font-size:12pt; text-align:center; margin:4mm 0; } h2 {font-size:10pt;margin:4mm 0 1mm;break-after:avoid;} h3 {font-size:9pt;break-after:avoid;}
.source { text-align:right; font-size:8pt; margin-bottom:5mm; } .number {text-align:right;font-size:8pt;}
table { width:100%;border-collapse:collapse;table-layout:fixed; } td,th { border:.5pt solid black;padding:1.2mm;vertical-align:top;overflow-wrap:anywhere; } th {background:#eee;text-align:left;} tr {break-inside:avoid;} thead {display:table-header-group;}
.box { display:inline-block;width:2.5mm;height:2.5mm; border:.5pt solid #000; text-align:center; font:8pt/2.3mm sans-serif;vertical-align:-.4mm;margin:0 .6mm; }
.value {white-space:pre-line;min-height:4mm;display:block;} .label {font-size:8pt;} .center{text-align:center;} .section{background:#eee;font-weight:bold;} .signature {height:15mm;} .notes {min-height:12mm;white-space:pre-wrap;overflow-wrap:anywhere;} .newpage{break-before:page;} .small{font-size:7.5pt;} .space {height:9mm;} .appendix p{white-space:pre-wrap;overflow-wrap:anywhere;} .appendix{break-before:page;}
.columns {border:0;} .columns>tbody>tr>td {border:0;padding:0 1.5mm;vertical-align:top;} .defect-table {font-size:7pt;} .defect-table td,.defect-table th{padding:.6mm;} .defect-table td{height:6.5mm;} .defect-table .box{width:2mm;height:2mm;font-size:6pt;line-height:1.7mm;margin:0;}
.tram-card h2 {margin:2mm 0 .7mm;} .tram-card h3 {margin:1.2mm 0 .5mm;} .tram-card td,.tram-card th {padding:.8mm;} .tram-card .space {height:5mm;}
@media screen {body{max-width:186mm;margin:20px auto;padding:8mm;box-shadow:0 0 5px #bbb;} .newpage,.appendix{margin-top:20mm;border-top:1px dashed #aaa;padding-top:8mm;} }
</style></head><body>
{% macro box(value=false) %}<span class="box">{% if value %}×{% endif %}</span>{% endmacro %}
{% macro field(label,value='') %}<span class="label">{{ label }}</span><span class="value">{{ value }}</span>{% endmacro %}
{% macro category_choices() %}{% for code,name in categories %}{{ box(fields.category == code or fields.category == name) }} {{ name }} {% endfor %} {{ fields.categoryOther }}{% endmacro %}
{% macro appeal() %}<h2>Haldusakti edasikaebamine</h2><p class="small">Käesoleva haldusakti peale võib esitada vaide Politsei- ja Piirivalveameti peadirektorile haldusmenetluse seaduses sätestatud korras ja tähtajal või kaebuse halduskohtule halduskohtumenetluse seadustikus sätestatud korras ja tähtajal.</p>{% endmacro %}
{% block body %}{% endblock %}
{% if appendix %}<section class="appendix"><h1>Kontrollkaardi lisa — {{ number }}</h1>{% for item in appendix %}<h3>{{ item.title }}</h3><p>{{ item.text }}</p>{% endfor %}</section>{% endif %}
</body></html>
