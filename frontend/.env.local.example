# Copy this file to .env.local and adjust values for local development.
# .env.local is git-ignored and never committed.

# Set to true to route all /api requests through mock DSL endpoints.
# When true:  /api/v1/users/admin/list  →  /ljvis/v1/users/admin/mock/list
# When false: /api/v1/users/admin/list  →  /ljvis/v1/users/admin/list
VITE_USE_MOCK=true
