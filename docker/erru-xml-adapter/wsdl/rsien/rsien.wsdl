umentation>The name of the transport undertaking as recorded in the register.</xs:documentation></xs:annotation></xs:attribute><xs:attribute name="communityLicenceNumber" type="globalCommunityLicenceNumberType" use="required"><xs:annotation><xs:documentation>The number of the community licence of the transport undertaking or the number of the certified true copy of the community licence as recorded in the register.</xs:documentation></xs:annotation></xs:attribute></xs:complexType></xs:element></xs:sequence><xs:sequence><xs:element name="SearchByNameAndVehicle"><xs:annotation><xs:documentation>Search by using the vehicle registration and then by using the community licence number (or certified true copy number) and / or the transport undertaking name if they are supplied.</xs:documentation></xs:annotation><xs:complexType><xs:sequence><xs:element name="Vehicle" type="globalVehicleRegistrationType"/></xs:sequence><xs:attribute name="transportUndertakingName" type="globalTransportUndertakingNameType" use="required"><xs:annotation><xs:documentation>The name of the transport undertaking as recorded in the register.</xs:documentation></xs:annotation></xs:attribute><xs:attribute name="communityLicenceNumber" type="globalCommunityLicenceNumberType" use="optional"><xs:annotation><xs:documentation>The number of the community licence of the transport undertaking or the number of the certified true copy of the community licence as recorded in the register.</xs:documentation></xs:annotation></xs:attribute></xs:complexType></xs:element></xs:sequence></xs:choice><xs:attribute name="requestAllVehicles" type="xs:boolean" use="required"><xs:annotation><xs:documentation>If @requestAllVehicles=true in the request then the response should have Body/TransportUndertaking/VehicleRegistrations/Vehicle elements for each vehicle managed by the transport undertaking.</xs:documentation></xs:annotation></xs:attribute></xs:complexType><xs:complexType name="ctudTransportUndertakingType"><xs:sequenc