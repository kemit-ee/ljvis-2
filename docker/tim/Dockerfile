FROM turnerrainer/tim:0.2.0-alpha.2

# TIM generates an RSA key here on first start if the file is missing.
# In CI/dev the key is mounted via a Docker named volume so it survives
# container restarts without baking a private key into the image.

# Generate a self-signed RSA key at build time (dev/CI only).
# Production should mount a real key via a secret volume.
USER root
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends openssl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Ensure the key directory exists; the actual key is injected at runtime
# (named volume or mount).  We create the dir here so the non-root user
# can write to it if needed.
RUN mkdir -p /opt/tim/keys && chmod 700 /opt/tim/keys

# rootCA.pem is generated by tara-mock at first start and stored in the
# shared named volume. We copy it in at container start via an entrypoint
# wrapper so TIM trusts the self-signed TARA-Mock CA for OIDC calls.
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

COPY tim.yaml /app/tim.yaml

ENTRYPOINT ["/usr/bin/tini", "--", "/entrypoint.sh"]
