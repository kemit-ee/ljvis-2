# Copy this file to .env and fill in real values.
# .env is gitignored — never commit secrets.

# ── Cloudflare R2 / S3-compatible storage ─────────────────────────────────────
# Endpoint WITHOUT trailing slash, WITHOUT bucket name
S3_ENDPOINT=https://c3392559e79453c4b1ad8cffbec2b160.r2.cloudflarestorage.com
S3_BUCKET_NAME=ljvis
S3_REGION=auto
S3_ACCESS_KEY_ID=your-r2-access-key-id-here
S3_SECRET_ACCESS_KEY=your-r2-secret-access-key-here

# ── s3-proxy upload validation (all optional — defaults shown) ─────────────────
# S3 key prefix (folder) for all uploads
S3_KEY_PREFIX=protokollid
# Maximum allowed file size in megabytes
S3_MAX_SIZE_MB=20
# Maximum sanitized filename length (stem only, before extension)
S3_MAX_FILENAME_LENGTH=200
# Comma-separated list of allowed MIME types (leave empty to allow all detected types)
S3_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,application/vnd.etsi.asic-e+zip,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document
