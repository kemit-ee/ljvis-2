    {
      "name": "GET dashboard/summary — draft compound form appears with its sub-form",
      "request": {
        "method": "GET",
        "header": [{ "key": "Cookie", "value": "{{cookie_admin}}" }],
        "url": {
          "raw": "{{api_url}}/ljvis/v1/dashboard/summary",
          "host": ["{{api_url}}"],
          "path": ["ljvis", "v1", "dashboard", "summary"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "var raw = pm.response.json();",
              "var r = (raw && typeof raw === 'object' && 'response' in raw) ? raw.response : raw;",
              "var match = r.activeCompoundForms.find(c => String(c.compoundFormKey) === pm.environment.get('dash_compound_key'));",
              "pm.test('Created compound form is in activeCompoundForms (status=saved)', () => {",
              "  pm.expect(match).to.not.be.undefined;",
              "  pm.expect(match.status).to.eql('saved');",
              "  pm.expect(match.vehicleRegNr).to.eql(pm.environment.get('dash_vehicle_reg'));",
              "});",
              "pm.test('Sub-form appears nested with correct type/status', () => {",
              "  pm.expect(match.subForms).to.have.lengthOf(1);",
              "  pm.expect(match.subForms[0].formType).to.eql('sp_driver');",
              "  pm.expect(match.subForms[0].status).to.eql('saved');",
              "  pm.expect(String(match.subForms[0].formKey)).to.eql(pm.environment.get('dash_subform_key'));",
              "});",
              "pm.test('Overdue general-proceeding deadline (controlDate+45d, in the past) surfaces in needsAttention', () => {",
              "  var na = r.needsAttention.find(n => String(n.formKey) === pm.environment.get('dash_subform_key'));",
              "  pm.expect(na).to.not.be.undefined;",
              "  pm.expect(na.proceedingType).to.eql('general');",
              "  pm.expect(na.reason).to.eql('overdue');",
              "});"
            ]
          }
        }
      ]
    },
