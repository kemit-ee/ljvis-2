          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "var raw = pm.response.json();",
              "var r = (raw && typeof raw === 'object' && 'response' in raw) ? raw.response : raw;",
              "pm.test('Default scope is own', () => pm.expect(r.scope).to.eql('own'));",
              "pm.test('All 3 sections present as arrays', () => {",
              "  pm.expect(r.activeCompoundForms).to.be.an('array');",
              "  pm.expect(r.activeStandaloneForms).to.be.an('array');",
              "  pm.expect(r.needsAttention).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
