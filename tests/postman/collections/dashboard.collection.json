    {
      "name": "GET dashboard/summary — admin, no data yet → 200 with all sections",
      "request": {
        "method": "GET",
        "header": [{ "key": "Cookie", "value": "{{cookie_admin}}" }],
        "url": {
          "raw": "{{api_url}}/ljvis/v1/dashboard/summary",
