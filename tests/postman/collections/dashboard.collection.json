              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "var raw = pm.response.json();",
              "var unwrapped = (raw && typeof raw === 'object' && 'response' in raw) ? raw.response : raw;",
              "var row = Array.isArray(unwrapped) ? unwrapped[0] : unwrapped;",
              "pm.test('id present', () => pm.expect(row.id).to.not.be.undefined);",
