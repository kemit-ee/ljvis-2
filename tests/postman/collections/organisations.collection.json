            "dev",
            "dev-login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"personalCode\": \"{{pc_user}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "const token = typeof body === 'string' ? body : (body.response || body.token || '');",
              "pm.test('JWT token received', () => pm.expect(token).to.not.be.empty);",
              "pm.environment.set('cookie_noperm', 'customJwtCookie=' + token);"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /v1/organisations — no cookie → 401",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{api_url}}/ljvis/v1/organisations",
          "host": [
            "{{api_url}}"
          ],
          "path": [
            "ljvis",
            "v1",
            "organisations"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Returns 401 without cookie', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /v1/organisations — TARA user not registered in LJVIS → 401",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "{{cookie_noperm}}"
          }
        ],
        "url": {
          "raw": "{{api_url}}/ljvis/v1/organisations",
          "host": [
            "{{api_url}}"
          ],
          "path": [
            "ljvis",
            "v1",
            "organisations"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Returns 401 for TARA user not registered in LJVIS', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /v1/organisations — shape, content and sort order",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "{{cookie_admin}}"
          }
        ],
        "url": {
          "raw": "{{api_url}}/ljvis/v1/organisations",
          "host": [
            "{{api_url}}"
          ],
          "path": [
            "ljvis",
            "v1",
            "organisations"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "const orgs = Array.isArray(body) ? body : (body.response || []);",
              "pm.test('Response is an array', () => pm.expect(orgs).to.be.an('array'));",
              "pm.test('Exactly 8 seeded organisations', () => pm.expect(orgs.length).to.equal(8));",
              "pm.test('Each org has id (number), name (string) and code (string)', () => {",
              "  orgs.forEach(o => {",
              "    pm.expect(o).to.have.property('id');",
              "    pm.expect(Number(o.id)).to.be.a('number').and.to.be.above(0);",
              "    pm.expect(o.name).to.be.a('string').and.to.not.be.empty;",
              "    pm.expect(o.code).to.be.a('string').and.to.not.be.empty;",
              "  });",
              "});",
              "pm.test('No extra fields exposed (id, name and code only)', () => {",
              "  const keys = Object.keys(orgs[0]);",
              "  pm.expect(keys).to.have.members(['id', 'name', 'code']);",
              "});",
              "const names = orgs.map(o => o.name);",
              "pm.test('All seeded organisations present', () => {",
              "  pm.expect(names).to.have.members([",
              "    'CI Bootstrap Organisation',",
              "    'Eesti Rahvusvaheliste Autovedajate Assotsiatsioon',",
              "    'Justiitsministeerium',",
              "    'Kliimaministeerium',",
              "    'Maksu- ja Tolliamet',",
              "    'Politsei- ja Piirivalveamet',",
              "    'Tööinspektsioon',",
              "    'Transpordiamet'",
              "  ]);",
              "});",
              "pm.test('Results sorted alphabetically by name', () => {",
              "  pm.expect(names).to.eql([",
              "    'CI Bootstrap Organisation',",
              "    'Eesti Rahvusvaheliste Autovedajate Assotsiatsioon',",
              "    'Justiitsministeerium',",
              "    'Kliimaministeerium',",
              "    'Maksu- ja Tolliamet',",
              "    'Politsei- ja Piirivalveamet',",
              "    'Transpordiamet',",
              "    'Tööinspektsioon'",
              "  ]);",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": []
}
