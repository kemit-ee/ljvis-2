    {
      "name": "GET /v1/classifiers — list shape, total and sort order",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "{{cookie_admin}}"
          }
        ],
        "url": {
          "raw": "{{api_url}}/ljvis/v1/classifiers?page=1&pageSize=100",
          "host": [
            "{{api_url}}"
          ],
          "path": [
            "ljvis",
            "v1",
            "classifiers"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "pageSize",
              "value": "100"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "var body = pm.response.json();",
              "var data = (body && body.response) ? body.response : body;",
              "pm.test('Body has content array and total', () => {",
              "  pm.expect(Array.isArray(data.content)).to.be.true;",
              "  pm.expect(data.total).to.be.a('number');",
              "});",
              "pm.test('Total equals 58 (production Liquibase migrations + 1 CI-only TEST classifier)', () => pm.expect(data.total).to.eql(58));",
              "pm.test('Each item has id, code, name, description', () => {",
              "  data.content.forEach(c => {",
              "    pm.expect(c).to.include.keys('id', 'code', 'name', 'description');",
              "    pm.expect(c.code).to.be.a('string').and.not.empty;",
              "    pm.expect(c.name).to.be.a('string').and.not.empty;",
              "  });",
              "});",
              "pm.test('Sorted name asc — RTK before TEST', () => {",
              "  const codes = data.content.map(c => c.code);",
              "  pm.expect(codes.indexOf('RTK')).to.be.below(codes.indexOf('TEST'));",
              "});"
            ]
          }
        }
      ]
    },
