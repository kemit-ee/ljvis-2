              "var resp = (body && body.response) ? body.response : body;",
              "var data = resp.content || [];",
              "var total = resp.total || 0;",
              "pm.test('Response has content array', () => pm.expect(Array.isArray(data)).to.be.true);",
              "pm.test('Total equals 28 (27 EL liikmesriiki + 1 aegunud XX testtunnus)', () => pm.expect(parseInt(total)).to.eql(28));",
              "pm.test('Each value has classifierValueId, code, name, isValid, classifierId', () => {",
              "  data.forEach(v => {",
              "    pm.expect(v).to.include.keys('classifierValueId', 'code', 'name', 'isValid', 'classifierId');",
              "  });",
              "});",
              "pm.test('27 valid and 1 expired value', () => {",
              "  const valid = data.filter(v => v.isValid === 'true').length;",
              "  const expired = data.filter(v => v.isValid === 'false').length;",
              "  pm.expect(valid).to.eql(27);",
              "  pm.expect(expired).to.eql(1);",
              "});"
            ]
          }
        }
      ]
