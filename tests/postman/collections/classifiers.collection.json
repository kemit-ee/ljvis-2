        "const body = pm.response.json();",
        "const arr = Array.isArray(body) ? body : (body.response || []);",
        "pm.test('Response contains classifier value id', () => pm.expect(arr[0]).to.have.property('id'));",
        "pm.environment.set('created_classifier_value_id', String(arr[0].id));"
      ]}}]
