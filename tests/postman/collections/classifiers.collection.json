{
  "info": {
    "name": "LJVIS — Classifiers",
    "_postman_id": "ljvis-classifiers-v1",
    "description": "Functional tests for all /classifiers endpoints. Seed: RTK (4 values: EE/LV/LT valid, FI expired) + TEST (3 values: VALUE_A/VALUE_B valid, VALUE_C expired). Self-contained: authenticates and resolves IDs in Setup steps.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "[Auth] Login — Super Admin",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": {"raw": "{{api_url}}/ljvis/auth/dev/dev-login", "host": ["{{api_url}}"], "path": ["ljvis", "auth", "dev", "dev-login"]},
        "body": {"mode": "raw", "raw": "{\"personalCode\": \"{{pc_admin}}\"}"}
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Login returns 200', () => pm.response.to.have.status(200));",
        "var body = pm.response.json();",
        "var token = typeof body === 'string' ? body : (body.response || body.token || '');",
        "pm.test('JWT token received', () => pm.expect(token).to.not.be.empty);",
        "pm.environment.set('cookie_admin', 'customJwtCookie=' + token);"
      ]}}]
    },
    {
      "name": "[Auth] Login — No-perm User",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": {"raw": "{{api_url}}/ljvis/auth/dev/dev-login", "host": ["{{api_url}}"], "path": ["ljvis", "auth", "dev", "dev-login"]},
        "body": {"mode": "raw", "raw": "{\"personalCode\": \"{{pc_user}}\"}"}
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Login returns 200', () => pm.response.to.have.status(200));",
        "var body = pm.response.json();",
        "var token = typeof body === 'string' ? body : (body.response || body.token || '');",
        "pm.test('JWT token received', () => pm.expect(token).to.not.be.empty);",
        "pm.environment.set('cookie_noperm', 'customJwtCookie=' + token);"
      ]}}]
    },
    {
      "name": "[Setup] Save classifier IDs",
      "request": {
        "method": "GET",
        "header": [{"key": "Cookie", "value": "{{cookie_admin}}"}],
        "url": {
          "raw": "{{api_url}}/ljvis/v1/classifiers?page=1&pageSize=50",
          "host": ["{{api_url}}"],
          "path": ["ljvis", "v1", "classifiers"],
          "query": [{"key": "page", "value": "1"}, {"key": "pageSize", "value": "50"}]
        }
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Setup: classifier list returns 200', () => pm.response.to.have.status(200));",
        "var body = pm.response.json();",
        "var content = (body && body.response && body.response.content) ? body.response.content : [];",
        "pm.test('Setup: at least 2 classifiers seeded', () => pm.expect(content.length).to.be.at.least(2));",
        "var rtk = content.find(c => c.code === 'RTK');",
        "var test_ = content.find(c => c.code === 'TEST');",
        "pm.test('Setup: RTK classifier present', () => pm.expect(rtk, 'RTK not found').to.not.be.undefined);",
        "pm.test('Setup: TEST classifier present', () => pm.expect(test_, 'TEST not found').to.not.be.undefined);",
        "if (rtk)   pm.environment.set('seeded_classifier_id',   String(rtk.id));",
        "if (test_) pm.environment.set('seeded_classifier_id_2', String(test_.id));"
      ]}}]
    },
    {
      "name": "[Setup] Save seeded value ID (RTK/EE)",
      "request": {
        "method": "GET",
        "header": [{"key": "Cookie", "value": "{{cookie_admin}}"}],
        "url": {
          "raw": "{{api_url}}/ljvis/v1/classifiers/values?classifierId={{seeded_classifier_id}}&page=1&pageSize=50",
          "host": ["{{api_url}}"],
          "path": ["ljvis", "v1", "classifiers", "values"],
          "query": [{"key": "classifierId", "value": "{{seeded_classifier_id}}"}, {"key": "page", "value": "1"}, {"key": "pageSize", "value": "50"}]
        }
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Setup: values list returns 200', () => pm.response.to.have.status(200));",
        "var body = pm.response.json();",
        "var values = (body && body.response && Array.isArray(body.response)) ? body.response : [];",
        "var ee = values.find(v => v.code === 'EE');",
        "pm.test('Setup: EE value present in RTK', () => pm.expect(ee, 'EE not found').to.not.be.undefined);",
        "if (ee) pm.environment.set('seeded_value_id', String(ee.classifierValueId));"
      ]}}]
    },
