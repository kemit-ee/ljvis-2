        "const body = pm.response.json();",
        "const _d = body.response || body; const values = Array.isArray(_d) ? _d : (_d.content || []);",
        "pm.test('Response is an array', () => pm.expect(values).to.be.an('array'));",
        "pm.test('Each value has required fields', () => {",
        "  values.forEach(v => {",
        "    pm.expect(v).to.have.property('classifierValueId');",
        "    pm.expect(v).to.have.property('code');",
        "    pm.expect(v).to.have.property('name');",
        "    pm.expect(v).to.have.property('isValid');",
        "  });",
        "});"
      ]}}]
    },
