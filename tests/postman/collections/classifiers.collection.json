    {
      "name": "GET /v1/classifiers/values — ADR_CONTROL_CHECKPOINT has 46 values (16 punkti + 30 rikkumisliiki) (#229)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "{{cookie_admin}}"
          }
        ],
        "url": {
          "raw": "{{api_url}}/ljvis/v1/classifiers/values?classifierId={{adr_checkpoint_classifier_id}}&page=1&pageSize=100",
          "host": [
            "{{api_url}}"
          ],
          "path": [
            "ljvis",
            "v1",
            "classifiers",
            "values"
          ],
          "query": [
            {
              "key": "classifierId",
              "value": "{{adr_checkpoint_classifier_id}}"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "pageSize",
              "value": "100"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "var body = pm.response.json();",
              "var resp = (body && body.response) ? body.response : body;",
              "var data = resp.content || [];",
              "var total = parseInt(resp.total || 0);",
              "pm.test('Total equals 46 (16 kontrollkaardi punkti + 30 seotud 2016/403 rikkumisliiki)', () => pm.expect(total).to.eql(46));",
              "var codes = data.map(v => v.code);",
              "pm.test('Tase 1: punktid P12..P27 olemas', () => {",
              "  for (var i = 12; i <= 27; i++) pm.expect(codes).to.include('P' + i);",
              "});",
              "pm.test('Tase 2: sama rikkumisliik mitme punkti all eraldi kirjena', () => {",
              "  pm.expect(codes).to.include('RL10_P17');",
              "  pm.expect(codes).to.include('RL10_P19');",
              "  pm.expect(codes).to.include('RL23_P21');",
              "  pm.expect(codes).to.include('RL23_P22');",
              "  pm.expect(codes).to.include('RL23_P23');",
              "});",
              "pm.test('Tase 2 nimi algab 2016/403 numbriga ja lõpeb raskusastmega', () => {",
              "  var rl10 = data.find(v => v.code === 'RL10_P17');",
              "  pm.expect(rl10.name).to.match(/^10 – /);",
              "  pm.expect(rl10.name).to.match(/\\(VSI\\)$/);",
              "});"
            ]
          }
        }
      ]
    },
