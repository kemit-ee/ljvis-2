      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Login returns 200', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "const token = typeof body === 'string' ? body : (body.response || body.token || '');",
        "pm.test('JWT token received', () => pm.expect(token).to.not.be.empty);",
        "pm.environment.set('cookie_noperm', 'customJwtCookie=' + token);"
      ]}}]
    },
    {
      "name": "POST /v1/classifiers/read/list — no permission → 403",
      "request": {
        "method": "POST",
        "header": [{"key": "Cookie", "value": "{{cookie_noperm}}"}, {"key": "Content-Type", "value": "application/json"}],
        "url": {"raw": "{{api_url}}/ljvis/v1/classifiers/read/list", "host": ["{{api_url}}"], "path": ["ljvis", "v1", "classifiers", "read", "list"]},
        "body": {"mode": "raw", "raw": "{\"page\": 1, \"pageSize\": 20}"}
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Returns 403 without permission', () => pm.response.to.have.status(403));"
      ]}}]
    },
    {
      "name": "POST /v1/classifiers/read/list — shape, content and sort order",
      "request": {
        "method": "POST",
        "header": [{"key": "Cookie", "value": "{{cookie_admin}}"}, {"key": "Content-Type", "value": "application/json"}],
        "url": {"raw": "{{api_url}}/ljvis/v1/classifiers/read/list", "host": ["{{api_url}}"], "path": ["ljvis", "v1", "classifiers", "read", "list"]},
        "body": {"mode": "raw", "raw": "{\"page\": 1, \"pageSize\": 20}"}
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Returns 200', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "const _d = body.response || body; const classifiers = Array.isArray(_d) ? _d : (_d.content || []);",
        "pm.test('Response is an array', () => pm.expect(classifiers).to.be.an('array'));",
        "pm.test('Each classifier has id (number) and name (string)', () => {",
        "  classifiers.forEach(c => {",
        "    pm.expect(c).to.have.property('id');",
        "    pm.expect(Number(c.id)).to.be.a('number').and.to.be.above(0);",
        "    pm.expect(c.name).to.be.a('string').and.to.not.be.empty;",
        "  });",
        "});",
        "pm.test('Each classifier has id, code, name and description', () => {",
        "  if (classifiers.length > 0) {",
        "    const keys = Object.keys(classifiers[0]);",
        "    pm.expect(keys).to.have.members(['id', 'code', 'name', 'description']);",
        "  }",
        "});",
        "pm.test('Results sorted alphabetically by name', () => {",
        "  if (classifiers.length > 1) {",
        "    const names = classifiers.map(c => c.name);",
        "    for (let i = 1; i < names.length; i++) {",
        "      pm.expect(names[i] >= names[i-1], 'Names should be sorted alphabetically').to.be.true;",
        "    }",
        "  }",
        "});"
      ]}}]
    },
    {
      "name": "POST /v1/classifiers/read/list — with search filter",
      "request": {
        "method": "POST",
        "header": [{"key": "Cookie", "value": "{{cookie_admin}}"}, {"key": "Content-Type", "value": "application/json"}],
        "url": {"raw": "{{api_url}}/ljvis/v1/classifiers/read/list", "host": ["{{api_url}}"], "path": ["ljvis", "v1", "classifiers", "read", "list"]},
        "body": {"mode": "raw", "raw": "{\"search\": \"test\"}"}
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Returns 200', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "const _d = body.response || body; const classifiers = Array.isArray(_d) ? _d : (_d.content || []);",
        "pm.test('Response is an array', () => pm.expect(classifiers).to.be.an('array'));",
        "pm.test('Search filter is applied', () => {",
        "  if (classifiers.length > 0) {",
        "    classifiers.forEach(c => {",
        "      pm.expect(c.name.toLowerCase()).to.include('test');",
        "    });",
        "  }",
        "});"
      ]}}]
    },
    {
      "name": "POST /v1/classifiers/read/list — with pagination",
      "request": {
        "method": "POST",
        "header": [{"key": "Cookie", "value": "{{cookie_admin}}"}, {"key": "Content-Type", "value": "application/json"}],
        "url": {"raw": "{{api_url}}/ljvis/v1/classifiers/read/list", "host": ["{{api_url}}"], "path": ["ljvis", "v1", "classifiers", "read", "list"]},
        "body": {"mode": "raw", "raw": "{\"page\": 1, \"pageSize\": 10}"}
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Returns 200', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "const _d = body.response || body; const classifiers = Array.isArray(_d) ? _d : (_d.content || []);",
        "pm.test('Response is an array', () => pm.expect(classifiers).to.be.an('array'));",
        "pm.test('Pagination limit respected', () => {",
        "  pm.expect(classifiers.length).to.be.at.most(10);",
        "});"
      ]}}]
    },
    {
      "name": "[Setup] Save first classifier ID",
      "request": {
        "method": "POST",
        "header": [{"key": "Cookie", "value": "{{cookie_admin}}"}, {"key": "Content-Type", "value": "application/json"}],
        "url": {"raw": "{{api_url}}/ljvis/v1/classifiers/read/list", "host": ["{{api_url}}"], "path": ["ljvis", "v1", "classifiers", "read", "list"]},
        "body": {"mode": "raw", "raw": "{\"page\": 1, \"pageSize\": 1}"}
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Returns 200', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "const _d = body.response || body; const classifiers = Array.isArray(_d) ? _d : (_d.content || []);",
        "pm.test('At least one classifier found', () => pm.expect(classifiers.length).to.be.at.least(1));",
        "if (classifiers.length > 0) pm.environment.set('seeded_classifier_id', String(classifiers[0].id));"
      ]}}]
    },
