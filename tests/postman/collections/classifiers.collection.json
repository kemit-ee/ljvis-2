      "request": {
        "method": "GET",
        "header": [{"key": "Cookie", "value": "{{cookie_admin}}"}],
        "url": {
          "raw": "{{api_url}}/ljvis/v1/classifiers/values?classifierId={{seeded_classifier_id}}&page=1&pageSize=20",
          "host": ["{{api_url}}"],
