        "pm.test('Total equals 4', () => pm.expect(parseInt(data[0].total)).to.eql(4));",
        "pm.test('Each value has classifierValueId, code, name, isValid, classifierId', () => {",
        "  data.forEach(v => {",
        "    pm.expect(v).to.include.keys('classifierValueId', 'code', 'name', 'isValid', 'classifierId');",
        "  });",
        "});",
        "pm.test('3 valid and 1 expired value', () => {",
        "  const valid = data.filter(v => v.isValid === 'true').length;",
        "  const expired = data.filter(v => v.isValid === 'false').length;",
        "  pm.expect(valid).to.eql(3);",
        "  pm.expect(expired).to.eql(1);",
        "});"
      ]}}]
