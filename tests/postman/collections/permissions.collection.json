    {
      "name": "GET /v1/permissions — shape, content and sort order",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "{{cookie_admin}}"
          }
        ],
        "url": {
          "raw": "{{api_url}}/ljvis/v1/permissions",
          "host": [
            "{{api_url}}"
          ],
          "path": [
            "ljvis",
            "v1",
            "permissions"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "const perms = Array.isArray(body) ? body : (body.response || []);",
              "pm.test('Response is an array', () => pm.expect(perms).to.be.an('array'));",
              "pm.test('Exactly 43 seeded permissions', () => pm.expect(perms.length).to.equal(43));",
              "pm.test('Each permission has id, code and description', () => {",
              "  perms.forEach(p => {",
              "    pm.expect(p).to.have.property('id');",
              "    pm.expect(Number(p.id)).to.be.a('number').and.to.be.above(0);",
              "    pm.expect(p.code).to.be.a('string').and.to.not.be.empty;",
              "    pm.expect(p.description).to.be.a('string').and.to.not.be.empty;",
              "  });",
              "});",
              "pm.test('No extra fields exposed (id, code, description only)', () => {",
              "  const keys = Object.keys(perms[0]).sort();",
              "  pm.expect(keys).to.deep.equal(['code', 'description', 'id'].sort());",
              "});",
              "const codes = perms.map(p => p.code);",
              "pm.test('All user_group permissions present', () => {",
              "  ['user_group.list.admin','user_group.list.local','user_group.read.admin','user_group.read.local',",
              "   'user_group.create','user_group.update','user_group.list_users.admin','user_group.list_users.local',",
              "   'user_group.search_eligible_users','user_group.add_user','user_group.remove_user'",
              "  ].forEach(code => pm.expect(codes).to.include(code));",
              "});",
              "pm.test('All user permissions present', () => {",
              "  ['user.list.admin','user.list.local','user.read.admin','user.read.local',",
              "   'user.edit.admin','user.edit.local'",
              "  ].forEach(code => pm.expect(codes).to.include(code));",
              "});",
              "pm.test('Catalogue permissions present', () => {",
              "  pm.expect(codes).to.include('organisation.list');",
              "  pm.expect(codes).to.include('permission.list');",
              "});",
              "pm.test('Labour inspection and control form permissions present', () => {",
              "  ['labour_inspection_form.write','labour_inspection_form.read','control_form.view_unpublished','control_form.delete']",
              "    .forEach(code => pm.expect(codes).to.include(code));",
              "});",
              "pm.test('Vehicle/trailer technical and transport interruption form permissions present', () => {",
              "  ['control_form.edit_locked','compound_form.write',",
              "   'vehicle_technical_form.write','vehicle_technical_form.read',",
              "   'trailer_technical_form.write','trailer_technical_form.read',",
              "   'transport_interruption_form.write','transport_interruption_form.read'",
              "  ].forEach(code => pm.expect(codes).to.include(code));",
              "});",
              "pm.test('ADR form permissions present', () => {",
              "  ['adr_form.write','adr_form.read'].forEach(code => pm.expect(codes).to.include(code));",
              "});",
              "pm.test('Good repute form permissions present', () => {",
              "  ['good_repute_form.write','good_repute_form.read'].forEach(code => pm.expect(codes).to.include(code));",
              "});",
              "pm.test('Rahvastikuregister query permission present', () => {",
              "  pm.expect(codes).to.include('xtee.query.rahvastikuregister');",
              "});",
              "pm.test('Results are ordered: organisation before permission before user', () => {",
              "  const iOrg  = codes.indexOf('organisation.list');",
              "  const iPerm = codes.indexOf('permission.list');",
              "  const iUser = codes.findIndex(c => c.startsWith('user'));",
              "  pm.expect(iOrg).to.be.above(-1);",
              "  pm.expect(iOrg).to.be.below(iPerm, 'organisation.list before permission.list');",
              "  pm.expect(iPerm).to.be.below(iUser, 'permission.list before user.*');",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": []
}
