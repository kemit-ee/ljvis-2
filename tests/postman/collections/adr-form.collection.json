      ]}}]
    },
    {
      "name": "POST adr-form/edit/save — create → 200, save id/subFormNumber, version=1",
      "request": {
        "method": "POST",
        "header": [{"key": "Cookie", "value": "{{cookie_admin}}"}, {"key": "Content-Type", "value": "application/json"}],
        "url": {"raw": "{{api_url}}/ljvis/v1/control-forms/adr-form/edit/save", "host": ["{{api_url}}"], "path": ["ljvis", "v1", "control-forms", "adr-form", "edit", "save"]},
        "body": {"mode": "raw", "raw": "{\"compoundFormKey\": {{created_adr_compound_key}}, \"dangerousGoods\": \"[{\\\"unNumber\\\":\\\"1090\\\",\\\"packagingGroup\\\":\\\"II\\\",\\\"quantity\\\":100,\\\"unitCode\\\":\\\"L\\\"}]\", \"exemptionApplied\": false, \"infringements\": \"[]\", \"resultType\": \"ok\", \"correctiveMeasures\": \"[]\", \"sealOpened\": false, \"notes\": \"CI ADR form\"}"}
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Returns 200', () => pm.response.to.have.status(200));",
        "var raw = pm.response.json();",
        "var unwrapped = (raw && typeof raw === 'object' && 'response' in raw) ? (typeof raw.response === 'string' ? JSON.parse(raw.response) : raw.response) : raw;",
        "var row = Array.isArray(unwrapped) ? unwrapped[0] : unwrapped;",
        "pm.test('Response has id, subFormNumber, version=1', () => {",
        "  pm.expect(row.id).to.not.be.undefined;",
        "  pm.expect(row.subFormNumber).to.be.a('string').and.not.empty;",
        "  pm.expect(Number(row.version)).to.eql(1);",
        "});",
        "pm.test('subFormNumber starts with ov-', () => pm.expect(row.subFormNumber).to.match(/^ov-/));",
        "pm.environment.set('created_adr_id', String(row.id));",
        "pm.environment.set('created_adr_sub_form_number', String(row.subFormNumber));"
      ]}}]
    },
