    },
    {
      "name": "POST adr-form/edit/save — notes over 4000 chars → 422 max_length_4000",
      "request": {
        "method": "POST",
        "header": [{"key": "Cookie", "value": "{{cookie_admin}}"}, {"key": "Content-Type", "value": "application/json"}],
        "url": {"raw": "{{api_url}}/ljvis/v1/control-forms/adr-form/edit/save", "host": ["{{api_url}}"], "path": ["ljvis", "v1", "control-forms", "adr-form", "edit", "save"]},
        "body": {"mode": "raw", "raw": "{\"compoundFormKey\": {{created_adr_compound_key}}, \"dangerousGoods\": \"[]\", \"resultType\": \"ok\", \"notes\": \"{{long_string_4001}}\"}"}
