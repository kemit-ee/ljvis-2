        "pm.test('version is 1', () => pm.expect(Number(body.version)).to.eql(1));",
        "pm.test('notes match', () => pm.expect(body.notes).to.eql('CI ADR form'));",
        "pm.test('resultType is ok', () => pm.expect(body.resultType).to.eql('ok'));",
