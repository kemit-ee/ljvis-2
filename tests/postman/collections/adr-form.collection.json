{
  "info": {
    "name": "LJVIS — ADR Form (Ohtlik Veos)",
    "_postman_id": "ljvis-adr-form-v1",
    "description": "Functional tests for /control-forms/adr-form endpoints (LJVIS2-141). Covers permission boundaries (adr_form.write/read, control_form.edit_locked), backend validation (compoundFormKey required, notes max length), version/status lifecycle (saved -> confirmed, already_confirmed, form_locked_after_publish), and the X-tee fields block. Self-contained: authenticates and creates its own compound form + ADR sub-form.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "[Auth] Login — Super Admin",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": {"raw": "{{api_url}}/ljvis/auth/dev/dev-login", "host": ["{{api_url}}"], "path": ["ljvis", "auth", "dev", "dev-login"]},
        "body": {"mode": "raw", "raw": "{\"personalCode\": \"{{pc_admin}}\"}"}
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Login returns 200', () => pm.response.to.have.status(200));",
        "var body = pm.response.json();",
        "var token = typeof body === 'string' ? body : (body.response || body.token || '');",
        "pm.test('JWT token received', () => pm.expect(token).to.not.be.empty);",
        "pm.environment.set('cookie_admin', 'customJwtCookie=' + token);"
      ]}}]
    },
    {
      "name": "[Auth] Login — No-perm User",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": {"raw": "{{api_url}}/ljvis/auth/dev/dev-login", "host": ["{{api_url}}"], "path": ["ljvis", "auth", "dev", "dev-login"]},
        "body": {"mode": "raw", "raw": "{\"personalCode\": \"{{pc_user}}\"}"}
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Login returns 200', () => pm.response.to.have.status(200));",
        "var body = pm.response.json();",
        "var token = typeof body === 'string' ? body : (body.response || body.token || '');",
        "pm.test('JWT token received', () => pm.expect(token).to.not.be.empty);",
        "pm.environment.set('cookie_noperm', 'customJwtCookie=' + token);"
      ]}}]
    },
    {
      "name": "[Setup] Create compound form for ADR sub-form tests",
      "request": {
        "method": "POST",
        "header": [{"key": "Cookie", "value": "{{cookie_admin}}"}, {"key": "Content-Type", "value": "application/json"}],
        "url": {"raw": "{{api_url}}/ljvis/v1/control-forms/compound-form/edit/insert", "host": ["{{api_url}}"], "path": ["ljvis", "v1", "control-forms", "compound-form", "edit", "insert"]},
        "body": {"mode": "raw", "raw": "{\"status\":\"saved\",\"controlDate\":\"2024-01-01\",\"controlTime\":\"10:00\",\"controlCountryCode\":\"EE\",\"county\":\"\",\"city\":\"Tallinn\",\"road\":\"\",\"roadOther\":\"\",\"kilometer\":\"\",\"address\":\"\",\"road_type\":\"\",\"roadTaxStatus\":\"\",\"roadTaxNotes\":\"\",\"vehicleRegNr\":\"CI123ADR\",\"vehicleMake\":\"\",\"vehicleModel\":\"\",\"vehicleCountryCode\":\"EE\",\"vehicleVin\":\"\",\"vehicleFirstRegistration\":\"\",\"vehicleBodyType\":\"\",\"vehicleCategoryCode\":\"\",\"vehicleCategoryOther\":\"\",\"vehicleMileage\":\"\",\"trailers\":\"[]\",\"companyRegCode\":\"\",\"companyName\":\"\",\"companyCountryCode\":\"\",\"companyCounty\":\"\",\"companyCity\":\"\",\"companyAddressLine1\":\"\",\"companyPostalCode\":\"\",\"companyOwnerFirstName\":\"\",\"companyOwnerLastName\":\"\",\"companyActivityLicenceCopyNumber\":\"\",\"drivers\":\"[]\",\"inspectorFirstName\":\"\",\"inspectorLastName\":\"\",\"inspectorOrganisationId\":\"\",\"inspectorUnit\":\"\",\"inspectorProfession\":\"\",\"driver1PersonalCodeEe\":\"\",\"driver1PersonalCodeForeign\":\"\",\"driver2PersonalCodeEe\":\"\",\"driver2PersonalCodeForeign\":\"\"}"}
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Returns 200', () => pm.response.to.have.status(200));",
        "var raw = pm.response.json();",
        "var unwrapped = (raw && typeof raw === 'object' && 'response' in raw) ? (typeof raw.response === 'string' ? JSON.parse(raw.response) : raw.response) : raw;",
        "var row = Array.isArray(unwrapped) ? unwrapped[0] : unwrapped;",
        "pm.test('id present', () => pm.expect(row.id).to.not.be.undefined);",
        "pm.environment.set('created_adr_compound_key', String(row.id));"
      ]}}]
    },
