    {
      "name": "[Setup] Create labour-inspection act (searchable form)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.environment.set('fs_company_name', 'CI Search ' + Date.now());",
              "pm.environment.set('fs_inspection_date', '2024-03-14');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "var raw = pm.response.json();",
              "var d = (raw && typeof raw === 'object' && 'response' in raw) ? raw.response : raw;",
              "if (typeof d === 'string') { try { d = JSON.parse(d); } catch (e) {} }",
              "var row = Array.isArray(d) ? d[0] : d;",
              "pm.environment.set('fs_lif_id', String(row.id));",
              "pm.environment.set('fs_lif_form_number', String(row.formNumber));",
              "pm.test('Created act has id + formNumber', () => {",
              "  pm.expect(row.id).to.not.be.undefined;",
              "  pm.expect(row.formNumber).to.be.a('string').and.not.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Cookie",
            "value": "{{cookie_admin}}"
          },
          {
