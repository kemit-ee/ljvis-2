{
  "info": {
    "name": "LJVIS — Form Search (LJVIS2-9)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Cross-entity form search (LJVIS2-9). Endpoint returns the raw result array (each row carries a total window-count). Verifies 403 without form read permission, unfiltered search, formType/companyName/date-range filters, pagination, sorting, that deleted forms are hidden, and — critically — that a form with multiple saved snapshot versions (insert-only history) surfaces as exactly ONE row carrying the latest snapshot's data (see forms.form_search view, DISTINCT ON (key) ORDER BY key, created_at DESC)."
  },
  "item": [
    {
      "name": "[Auth] Login — Super Admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{api_url}}/ljvis/auth/dev/dev-login",
          "host": [
            "{{api_url}}"
          ],
          "path": [
            "ljvis",
            "auth",
            "dev",
            "dev-login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"personalCode\": \"{{pc_admin}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login 200', () => pm.response.to.have.status(200));",
              "var b = pm.response.json();",
              "var token = typeof b === 'string' ? b : (b.response || b.token || '');",
              "pm.environment.set('cookie_admin', 'customJwtCookie=' + token);"
            ]
          }
        }
      ]
    },
