    {
      "name": "GET search/list — 3 snapshot versions of same form → exactly 1 row, latest data",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "{{cookie_admin}}"
          }
        ],
        "url": {
          "raw": "{{api_url}}/ljvis/v1/control-forms/search/list?companyName={{fs_company_name}}&pageSize=100",
          "host": [
            "{{api_url}}"
          ],
          "path": [
            "ljvis",
            "v1",
            "control-forms",
            "search",
            "list"
          ],
          "query": [
            {
              "key": "companyName",
              "value": "{{fs_company_name}}"
            },
            {
              "key": "pageSize",
              "value": "100"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "var raw = pm.response.json();",
              "var data = (raw && typeof raw === 'object' && 'response' in raw) ? raw.response : raw;",
              "if (typeof data === 'string') { try { data = JSON.parse(data); } catch (e) {} }",
              "var rows = Array.isArray(data) ? data : (data && data.content) || [];",
              "var matches = rows.filter(r => String(r.formKey) === pm.environment.get('fs_lif_id'));",
              "pm.test('Exactly ONE row for this form key despite 3 saved snapshot versions', () => {",
              "  pm.expect(matches.length).to.eql(1, 'form_search view/search query must dedupe snapshot history to a single latest row per form key — got ' + matches.length);",
              "});",
              "pm.test('Row reflects the LATEST snapshot data, not an older version', () => {",
              "  pm.expect(matches[0].companyName).to.eql(pm.environment.get('fs_company_name_v2'));",
              "  pm.expect(matches[0].hasViolation).to.eql(true, 'has_violation must reflect latest snapshot (violations non-empty)');",
              "});"
            ]
          }
        }
      ]
    },
