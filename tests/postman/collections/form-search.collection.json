              "pm.test('Created act is included in sorted results', () => {",
              "  var keys = rows.map(r => String(r.formKey || r.id || ''));",
              "  pm.expect(keys).to.include(pm.environment.get('fs_lif_id'));",
              "});",
              "pm.test('Rows are ordered ascending by mainDate', () => {",
              "  var dates = rows.map(r => r.mainDate || r.inspectionDate).filter(Boolean);",
              "  var sorted = [...dates].sort();",
              "  pm.expect(dates).to.eql(sorted, 'main_date asc ordering not honoured');",
              "});"
            ]
          }
        }
      ]
