{
  "info": {
    "name": "LJVIS — Foreign Violation Form",
    "_postman_id": "ljvis-foreign-violation-form-v1",
    "description": "Functional tests for /control-forms/foreign-violation-form endpoints. Covers permission boundaries, backend validation (required fields), version/status lifecycle (saved -> confirmed -> published), locked-after-confirm, the saved-state no-version-bump rule, and the edit_locked-gated re-save of confirmed/published data (officer blocked, admin allowed with version bump). Self-contained: authenticates and creates its own test data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "[Auth] Login — Super Admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{api_url}}/ljvis/auth/dev/dev-login",
          "host": [
            "{{api_url}}"
          ],
          "path": [
            "ljvis",
            "auth",
            "dev",
            "dev-login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"personalCode\": \"{{pc_admin}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login returns 200', () => pm.response.to.have.status(200));",
              "var body = pm.response.json();",
              "var token = typeof body === 'string' ? body : (body.response || body.token || '');",
              "pm.test('JWT token received', () => pm.expect(token).to.not.be.empty);",
              "pm.environment.set('cookie_admin', 'customJwtCookie=' + token);"
            ]
          }
        }
      ]
    },
