{
  "info": {
    "name": "LJVIS \u2014 Audit Log (auditilogi + asutuse-skoop)",
    "_postman_id": "ljvis-audit-log-v1",
    "description": "Functional tests for the audit log endpoints (GET /v1/logs, /v1/logs/log, /v1/logs/export, /v1/logs/verify). Covers the permission boundary and the organisation scope: audit.read sees every organisation's events; audit.read.local sees only events whose actor belonged to the caller's own organisation; audit.verify (chain integrity check) is global and Super-Admin only. Self-contained: seeds audit events with known organisation_id values via Resql insert_audit_event and asserts each role sees exactly its allowed slice.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "[Auth] Login \u2014 Super Admin (audit.read)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "var b = pm.response.json(); var t = typeof b === 'string' ? b : (b.response || b.token || '');",
              "pm.environment.set('cookie_admin', 'customJwtCookie=' + t);"
            ]
          }
        }
      ],
      "request": {
