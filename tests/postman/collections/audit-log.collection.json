    {
      "name": "[Setup] Resolve JUM + PPA organisation ids",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "var raw = pm.response.json(); var body = (raw && typeof raw === 'object' && !Array.isArray(raw) && 'response' in raw) ? raw.response : raw;",
              "var orgs = Array.isArray(body) ? body : [];",
              "var jum = orgs.find(o => o.code === 'JUM'); var ppa = orgs.find(o => o.code === 'PPA');",
              "pm.test('JUM + PPA present', () => { pm.expect(jum).to.not.be.undefined; pm.expect(ppa).to.not.be.undefined; });",
              "pm.environment.set('org_jum_id', String(jum.id));",
              "pm.environment.set('org_ppa_id', String(ppa.id));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{resql_ljvis_url}}/organisation/list_organisations",
          "host": [
            "{{resql_ljvis_url}}"
          ],
          "path": [
            "organisation",
            "list_organisations"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "response": []
    },
