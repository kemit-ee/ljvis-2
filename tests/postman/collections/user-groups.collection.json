    {
      "name": "[Setup] Save org ID",
      "request": {
        "method": "POST",
        "header": [{"key": "Cookie", "value": "{{cookie_admin}}"}, {"key": "Content-Type", "value": "application/json"}],
        "url": {"raw": "{{api_url}}/ljvis/v1/organisations/list", "host": ["{{api_url}}"], "path": ["ljvis", "v1", "organisations", "list"]},
        "body": {"mode": "raw", "raw": "{}"}
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Returns 200', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "const orgs = Array.isArray(body) ? body : (body.response || []);",
        "const org = orgs.find(o => o.name === 'Justiitsministeerium');",
        "pm.test('Justiitsministeerium org found', () => pm.expect(org).to.not.be.undefined);",
        "if (org) pm.environment.set('seeded_org_bootstrap_id', String(org.id));"
      ]}}]
    },
    {
      "name": "[Setup] Save permission ID",
      "request": {
        "method": "POST",
        "header": [{"key": "Cookie", "value": "{{cookie_admin}}"}, {"key": "Content-Type", "value": "application/json"}],
        "url": {"raw": "{{api_url}}/ljvis/v1/permissions/list", "host": ["{{api_url}}"], "path": ["ljvis", "v1", "permissions", "list"]},
        "body": {"mode": "raw", "raw": "{}"}
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Returns 200', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "const perms = Array.isArray(body) ? body : (body.response || []);",
        "const p = perms.find(p => p.code === 'user_group.update');",
        "if (p) pm.environment.set('seeded_permission_id', String(p.id));"
      ]}}]
    },
    {
      "name": "[Setup] Save seeded super admin group ID and no-group user ID",
      "request": {
        "method": "POST",
        "header": [{"key": "Cookie", "value": "{{cookie_admin}}"}, {"key": "Content-Type", "value": "application/json"}],
        "url": {"raw": "{{api_url}}/ljvis/v1/user-groups/admin/list", "host": ["{{api_url}}"], "path": ["ljvis", "v1", "user-groups", "admin", "list"]},
        "body": {"mode": "raw", "raw": "{\"page\": 1, \"pageSize\": 20}"}
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Returns 200', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "const _d = body.response || body; const groups = Array.isArray(_d) ? _d : (_d.content || []);",
        "const g = groups.find(g => g.name === 'Super Admin Group');",
        "pm.test('Super Admin Group found', () => pm.expect(g).to.not.be.undefined);",
        "if (g) pm.environment.set('seeded_group_admin_id', String(g.id));"
      ]}}]
    },
    {
      "name": "[Setup] Save seeded user ID (Super Admin)",
      "request": {
        "method": "POST",
        "header": [{"key": "Cookie", "value": "{{cookie_admin}}"}, {"key": "Content-Type", "value": "application/json"}],
        "url": {"raw": "{{api_url}}/ljvis/v1/users/admin/list", "host": ["{{api_url}}"], "path": ["ljvis", "v1", "users", "admin", "list"]},
        "body": {"mode": "raw", "raw": "{\"page\": 1, \"pageSize\": 20}"}
