        "pm.test('Returns 200', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "const _d = body.response || body; const users = Array.isArray(_d) ? _d : (_d.content || []);",
        "const u = users.find(u => u.personalCode === '60001019906');",
        "pm.test('Super Admin found', () => pm.expect(u).to.not.be.undefined);",
        "if (u) pm.environment.set('seeded_no_group_user_id', String(u.id));"
      ]}}]
