      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Returns 200', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "const groups = Array.isArray(body) ? body : (body.response || []);",
        "pm.test('Group returned', () => pm.expect(groups.length).to.be.above(0));",
        "pm.test('Group name is Super Admin Group', () => pm.expect(groups[0].name).to.equal('Super Admin Group'));",
        "pm.test('Group has id and name', () => {",
        "  pm.expect(groups[0]).to.have.property('id');",
        "  pm.expect(groups[0]).to.have.property('name');",
        "});"
      ]}}]
