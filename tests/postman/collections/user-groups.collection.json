    {
      "name": "GET /v1/user-groups/admin/search — admin sees all groups",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "{{cookie_admin}}"
          }
        ],
        "url": {
          "raw": "{{api_url}}/ljvis/v1/user-groups/admin/search?page=1&pageSize=20",
          "host": [
            "{{api_url}}"
          ],
          "path": [
            "ljvis",
            "v1",
            "user-groups",
            "admin",
            "search"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "pageSize",
              "value": "20"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "const _d = body.response || body;",
              "const paged = (Array.isArray(_d)) ? {content: _d, total: _d.length} : _d;",
              "const arr = Array.isArray(paged) ? paged : (paged.content || paged.response || []);",
              "pm.test('Response has content and total', () => {",
              "  pm.expect(paged).to.have.property('content');",
              "  pm.expect(paged).to.have.property('total');",
              "  pm.expect(paged.content).to.be.an('array');",
              "});",
              "pm.test('At least 2 seeded groups visible', () => pm.expect(arr.length).to.be.at.least(2));",
              "pm.test('Group has id and name', () => {",
              "  pm.expect(arr[0]).to.have.property('id');",
              "  pm.expect(arr[0]).to.have.property('name');",
              "});",
              "pm.test('Super Admin Group has at least one organisation assigned', () => {",
              "  const superAdmin = arr.find(g => g.name === 'Super Admin Group');",
              "  pm.expect(superAdmin, 'Super Admin Group not found').to.not.be.undefined;",
              "  pm.expect(superAdmin.organisations).to.be.an('array');",
              "  pm.expect(superAdmin.organisations.length).to.be.above(0, 'Super Admin Group must have >=1 org');",
              "  // /admin/search returns organisations as array of strings (org names)",
              "  pm.expect(superAdmin.organisations[0]).to.be.a('string').and.not.be.empty;",
              "});"
            ]
          }
        }
      ]
