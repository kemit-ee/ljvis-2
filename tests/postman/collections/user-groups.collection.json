    {
      "name": "[Setup] Save org ID",
      "request": {
        "method": "GET",
        "header": [{"key": "Cookie", "value": "{{cookie_admin}}"}],
        "url": {"raw": "{{api_url}}/ljvis/v1/organisations?page=1&pageSize=100", "host": ["{{api_url}}"], "path": ["ljvis", "v1", "organisations"], "query": [{"key": "page", "value": "1"}, {"key": "pageSize", "value": "100"}]}
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Returns 200', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "const orgs = Array.isArray(body) ? body : (body.response || body.content || []);",
        "const org = orgs.find(o => o.name === 'Justiitsministeerium');",
        "pm.test('Justiitsministeerium org found', () => pm.expect(org).to.not.be.undefined);",
        "if (org) pm.environment.set('seeded_org_bootstrap_id', String(org.id));"
      ]}}]
    },
    {
      "name": "[Setup] Save permission ID",
      "request": {
        "method": "GET",
        "header": [{"key": "Cookie", "value": "{{cookie_admin}}"}],
        "url": {"raw": "{{api_url}}/ljvis/v1/permissions?page=1&pageSize=100", "host": ["{{api_url}}"], "path": ["ljvis", "v1", "permissions"], "query": [{"key": "page", "value": "1"}, {"key": "pageSize", "value": "100"}]}
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Returns 200', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "const perms = Array.isArray(body) ? body : (body.response || body.content || []);",
        "const p = perms.find(p => p.code === 'user_group.update');",
        "if (p) pm.environment.set('seeded_permission_id', String(p.id));"
      ]}}]
    },
    {
      "name": "[Setup] Save seeded super admin group ID and no-group user ID",
      "request": {
        "method": "GET",
        "header": [{"key": "Cookie", "value": "{{cookie_admin}}"}],
        "url": {"raw": "{{api_url}}/ljvis/v1/user-groups/admin/search?page=1&pageSize=20", "host": ["{{api_url}}"], "path": ["ljvis", "v1", "user-groups", "admin", "search"], "query": [{"key": "page", "value": "1"}, {"key": "pageSize", "value": "20"}]}
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Returns 200', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "const paged = body.content !== undefined ? body : (body.response || {content: [], total: 0});",
        "const groups = Array.isArray(paged) ? paged : (paged.content || []);",
        "const g = groups.find(g => g.name === 'Super Admin Group');",
        "pm.test('Super Admin Group found', () => pm.expect(g).to.not.be.undefined);",
        "if (g) pm.environment.set('seeded_group_admin_id', String(g.id));"
      ]}}]
    },
    {
      "name": "[Setup] Save seeded user ID (Super Admin)",
      "request": {
        "method": "GET",
        "header": [{"key": "Cookie", "value": "{{cookie_admin}}"}],
        "url": {"raw": "{{api_url}}/ljvis/v1/users/admin/search?page=1&pageSize=20", "host": ["{{api_url}}"], "path": ["ljvis", "v1", "users", "admin", "search"], "query": [{"key": "page", "value": "1"}, {"key": "pageSize", "value": "20"}]}
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Returns 200', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "const paged = body.content !== undefined ? body : (body.response || {content: [], total: 0});",
        "const users = Array.isArray(paged) ? paged : (paged.content || []);",
        "const u = users.find(u => u.personalCode === '60001019906');",
        "pm.test('Super Admin found', () => pm.expect(u).to.not.be.undefined);",
        "if (u) pm.environment.set('seeded_no_group_user_id', String(u.id));"
      ]}}]
    },
    {
      "name": "GET /v1/user-groups/admin/search — admin sees all groups",
      "request": {
        "method": "GET",
        "header": [{"key": "Cookie", "value": "{{cookie_admin}}"}],
        "url": {"raw": "{{api_url}}/ljvis/v1/user-groups/admin/search?page=1&pageSize=20", "host": ["{{api_url}}"], "path": ["ljvis", "v1", "user-groups", "admin", "search"], "query": [{"key": "page", "value": "1"}, {"key": "pageSize", "value": "20"}]}
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Returns 200', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "const paged = body.content !== undefined ? body : (body.response || {content: [], total: 0});",
        "const arr = paged.content || [];",
        "pm.test('Response has content and total', () => {",
        "  pm.expect(paged).to.have.property('content');",
        "  pm.expect(paged).to.have.property('total');",
        "  pm.expect(paged.content).to.be.an('array');",
        "});",
        "pm.test('At least 2 seeded groups visible', () => pm.expect(arr.length).to.be.at.least(2));",
        "pm.test('Group has id and name', () => {",
        "  pm.expect(arr[0]).to.have.property('id');",
        "  pm.expect(arr[0]).to.have.property('name');",
        "});",
        "pm.test('organisations is an array', () => pm.expect(arr[0].organisations).to.be.an('array'));"
      ]}}]
    },
    {
      "name": "GET /v1/user-groups/admin/search — no permission → 403",
      "request": {
        "method": "GET",
        "header": [{"key": "Cookie", "value": "{{cookie_noperm}}"}],
        "url": {"raw": "{{api_url}}/ljvis/v1/user-groups/admin/search?page=1&pageSize=20", "host": ["{{api_url}}"], "path": ["ljvis", "v1", "user-groups", "admin", "search"], "query": [{"key": "page", "value": "1"}, {"key": "pageSize", "value": "20"}]}
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Returns 403 for user without permission', () => pm.response.to.have.status(403));"
      ]}}]
    },
    {
      "name": "GET /v1/user-groups/admin — admin gets seeded group",
      "request": {
        "method": "GET",
        "header": [{"key": "Cookie", "value": "{{cookie_admin}}"}],
        "url": {"raw": "{{api_url}}/ljvis/v1/user-groups/admin?q={{seeded_group_admin_id}}", "host": ["{{api_url}}"], "path": ["ljvis", "v1", "user-groups", "admin"], "query": [{"key": "q", "value": "{{seeded_group_admin_id}}"}]}
