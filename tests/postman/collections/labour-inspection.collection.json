{
  "info": {
    "name": "LJVIS — Labour Inspection Form",
    "_postman_id": "ljvis-labour-inspection-v1",
    "description": "Functional tests for /control-forms/labour-inspection endpoints (LJVIS2-75). Covers permission boundaries (labour_inspection_form.write/read, control_form.view_unpublished, control_form.delete), backend validation (required fields, max length, future date), version/status lifecycle (saved -> confirmed, locked-after-confirm), and delete. Self-contained: authenticates and creates its own test data.",
