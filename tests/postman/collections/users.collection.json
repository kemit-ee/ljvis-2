    {
      "name": "GET /v1/users/admin/search — search filter returns matching users",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "{{cookie_admin}}"
          }
        ],
        "url": {
          "raw": "{{api_url}}/ljvis/v1/users/admin/search?q=Admin&page=1&pageSize=20",
          "host": [
            "{{api_url}}"
          ],
          "path": [
            "ljvis",
            "v1",
            "users",
            "admin",
            "search"
          ],
          "query": [
            {
              "key": "q",
              "value": "Admin"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "pageSize",
              "value": "20"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "const _d = body.response || body; const arr = Array.isArray(_d) ? _d : (_d.content || []);",
              "pm.test('Search results returned (non-empty)', () => {",
              "  pm.expect(arr).to.be.an('array');",
              "  pm.expect(arr.length).to.be.at.least(1, '?q=Admin must match at least 1 user');",
              "});",
              "pm.test('All results match search term', () => {",
              "  arr.forEach(u => {",
              "    const name = (u.firstName + ' ' + u.lastName).toLowerCase();",
              "    pm.expect(name).to.include('admin');",
              "  });",
              "});"
            ]
          }
        }
      ]
