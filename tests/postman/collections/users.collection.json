        {
          "listen": "test",
          "script": {
            "exec": [
              "const sc = pm.response.code;",
              "if (sc === 200) {",
              "    pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "    const body = pm.response.json();",
              "    const arr = Array.isArray(body) ? body : (body.response || []);",
              "    pm.test('Response contains user id', () => pm.expect(arr[0]).to.have.property('id'));",
              "    pm.environment.set('created_user_id', String(arr[0].id));",
              "} else {",
              "    pm.test('Insert or already exists (re-run without DB reset)', () => pm.expect([200, 409]).to.include(sc));",
              "    pm.sendRequest({url: pm.environment.get('api_url') + '/ljvis/v1/users/admin/search?q=51001011234&page=1&pageSize=200', method: 'GET', header: {Cookie: pm.environment.get('cookie_admin')}}, function(err, res) {",
              "        if (!err && res.code === 200) { const u = (res.json().response?.content || res.json().content || []).find(u => u.personalCode === '51001011234'); if (u) pm.environment.set('created_user_id', String(u.id)); }",
              "    });",
              "}"
            ]
