        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "const paged = body.content !== undefined ? body : (body.response || {content: [], total: 0});",
              "const groups = Array.isArray(paged) ? paged : (paged.content || []);",
              "const g = groups.find(g => g.name === 'Super Admin Group');",
              "if (g) pm.environment.set('seeded_group_admin_id', String(g.id));"
            ]
          }
        }
