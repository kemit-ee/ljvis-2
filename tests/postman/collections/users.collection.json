    {
      "name": "GET /users/list — admin sees all users",
      "request": {
        "method": "GET",
        "header": [{"key": "Cookie", "value": "{{cookie_admin}}"}],
        "url": {
          "raw": "{{api_url}}/ljvis/users/list?page=1&pageSize=20",
          "host": ["{{api_url}}"],
          "path": ["ljvis", "users", "list"],
          "query": [{"key": "page", "value": "1"}, {"key": "pageSize", "value": "20"}]
        }
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Returns 200', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "const paged = body.response || {content: [], total: 0};",
        "const users = paged.content || [];",
        "pm.test('Response has content and total', () => {",
        "  pm.expect(paged).to.have.property('content');",
        "  pm.expect(paged).to.have.property('total');",
        "  pm.expect(paged.content).to.be.an('array');",
        "});",
        "pm.test('At least 1 seeded user visible', () => pm.expect(users.length).to.be.at.least(1));",
        "pm.test('User has required fields', () => {",
        "  pm.expect(users[0]).to.have.property('id');",
        "  pm.expect(users[0]).to.have.property('firstName');",
        "  pm.expect(users[0]).to.have.property('lastName');",
        "  pm.expect(users[0]).to.have.property('personalCode');",
        "});",
        "pm.test('userGroups is an array', () => pm.expect(users[0].userGroups).to.be.an('array'));"
      ]}}]
