        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "const orgs = Array.isArray(body) ? body : (body.response || body.content || []);",
              "const org = orgs.find(o => o.name === 'Justiitsministeerium');",
              "pm.test('Justiitsministeerium org found', () => pm.expect(org).to.not.be.undefined);",
              "if (org) pm.environment.set('seeded_org_bootstrap_id', String(org.id));"
            ]
