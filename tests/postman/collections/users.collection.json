          "raw": "{\"firstName\":\"Test\",\"lastName\":\"User CI\",\"personalCode\":\"51001011234\",\"organisationId\":\"{{seeded_org_bootstrap_id}}\",\"structuralUnitName\":\"Unit A\",\"jobTitleName\":\"Test Job\",\"email\":\"test.user@ci.test\",\"accessStart\":\"2026-01-01\"}"
