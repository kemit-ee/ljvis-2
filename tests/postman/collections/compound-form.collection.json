    {
      "name": "GET compound-form?q= after published resave → status published, new data persisted",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Cookie", "value": "{{cookie_admin}}" }
        ],
        "url": {
          "raw": "{{api_url}}/ljvis/v1/control-forms/compound-form?q={{created_cf_id}}",
          "host": ["{{api_url}}"],
          "path": ["ljvis", "v1", "control-forms", "compound-form"],
