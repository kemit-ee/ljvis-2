      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "var raw = pm.response.json();",
              "var f = (raw && typeof raw === 'object' && 'response' in raw) ? raw.response : raw;",
              "pm.test('status is saved', () => pm.expect(f.status).to.eql('saved'));",
              "pm.test('vehicleRegNr matches', () => pm.expect(f.vehicleRegNr).to.eql('CI001EE'));",
              "pm.test('address matches', () => pm.expect(f.address).to.eql('Testi tee 1'));"
            ]
          }
        }
      ]
