    {
      "name": "POST compound-form/edit/save — create (happy path) → 200, koond- number, version 1",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Cookie", "value": "{{cookie_admin}}" }
        ],
        "url": {
          "raw": "{{api_url}}/ljvis/v1/control-forms/compound-form/edit/save",
          "host": ["{{api_url}}"],
          "path": ["ljvis", "v1", "control-forms", "compound-form", "edit", "save"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"id\": \"\", \"status\": \"saved\", \"controlDate\": \"2026-01-15\", \"controlTime\": \"10:00\", \"controlCountryCode\": \"EE\", \"county\": \"\", \"city\": \"\", \"road\": \"\", \"roadOther\": \"\", \"kilometer\": \"\", \"address\": \"Testi tee 1\", \"road_type\": \"\", \"roadTaxStatus\": \"\", \"roadTaxNotes\": \"\", \"vehicleRegNr\": \"CI001EE\", \"vehicleMake\": \"DAF\", \"vehicleModel\": \"XF\", \"vehicleCountryCode\": \"EE\", \"vehicleVin\": \"\", \"vehicleFirstRegistration\": \"\", \"vehicleBodyType\": \"\", \"vehicleCategoryCode\": \"A_2012\", \"vehicleCategoryOther\": \"\", \"vehicleMileage\": \"\", \"trailers\": \"[]\", \"companyRegCode\": \"\", \"companyName\": \"\", \"companyCountryCode\": \"\", \"companyCounty\": \"\", \"companyCity\": \"\", \"companyAddressLine1\": \"\", \"companyPostalCode\": \"\", \"companyOwnerFirstName\": \"\", \"companyOwnerLastName\": \"\", \"companyActivityLicenceCopyNumber\": \"\", \"drivers\": \"[]\", \"inspectorFirstName\": \"CI\", \"inspectorLastName\": \"Tester\", \"inspectorOrganisationId\": \"1\", \"inspectorUnit\": \"\", \"inspectorProfession\": \"Inspektor\", \"driver1PersonalCodeEe\": \"\", \"driver1PersonalCodeForeign\": \"\", \"driver2PersonalCodeEe\": \"\", \"driver2PersonalCodeForeign\": \"\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "var raw = pm.response.json();",
              "var unwrapped = (raw && typeof raw === 'object' && 'response' in raw) ? (typeof raw.response === 'string' ? JSON.parse(raw.response) : raw.response) : raw;",
              "var row = Array.isArray(unwrapped) ? unwrapped[0] : unwrapped;",
              "pm.test('id present', () => pm.expect(row.id).to.be.a('number').and.above(0));",
              "pm.test('form number has koond- prefix', () => pm.expect(String(row.formNumber || row.form_number || '')).to.match(/^koond-\\d{4}-\\d+$/));",
              "pm.test('version is 1', () => pm.expect(row.version).to.eql(1));",
              "pm.environment.set('created_cf_id', String(row.id));"
            ]
          }
        }
      ]
    },
    {
      "name": "GET compound-form?q= → 200, status saved",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Cookie", "value": "{{cookie_admin}}" }
