          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "var raw = pm.response.json();",
              "var f = (raw && typeof raw === 'object' && 'response' in raw) ? raw.response : raw;",
              "pm.test('status is still published (regression: was being saved with old data)', () => pm.expect(f.status).to.eql('published'));",
              "pm.test('address updated to new value (regression: was returning old data)', () => pm.expect(f.address).to.eql('Testi tee 1 Published Resave'));",
