              "pm.test('Returns 200', () => pm.response.to.have.status(200));",
              "var b = pm.response.json(); var rows = b.response || b;",
              "var tram = rows.filter(r => String(r.formType||'').indexOf('tram') === 0);",
              "pm.test('at least one tram_compound / tram_driver row present', () => pm.expect(tram.length).to.be.above(0));",
              "pm.test('our tram compound is in the results', () => pm.expect(rows.some(r => String(r.formNumber||'').match(/^tram-/))).to.be.true);"
            ]
          }
        }
      ]
