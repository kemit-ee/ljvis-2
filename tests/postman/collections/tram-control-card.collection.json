{
  "info": {
    "name": "LJVIS — TRAM control card (ADR-002, single entity)",
    "_postman_id": "ljvis-tram-control-card-v1",
    "description": "Functional tests for /v1/control-forms/tram-card/** — the single-entity TRAM control card (forms.tram_control_card). Covers the tram_driver_form.write/read permission boundary, the tram-AAAA-NNNNN number series, the saved -> confirmed -> published lifecycle (publish only from confirmed), the driverNotApplicable path, controlDate validation, and the e-toimik auto-publish path (select_etoimik_candidates / apply_etoimik_decision idempotency). Self-contained.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "[Auth] Login — Super Admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{api_url}}/ljvis/auth/dev/dev-login"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"personalCode\": \"{{pc_admin}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "var b = pm.response.json(); var t = typeof b === 'string' ? b : (b.response || b.token || '');",
              "pm.environment.set('cookie_admin', 'customJwtCookie=' + t);"
            ]
          }
        }
      ]
    },
