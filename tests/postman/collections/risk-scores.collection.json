          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"company_reg_code\": \"90000001\", \"calculation_trigger\": \"admin\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "var b = pm.response.json().response;",
              "pm.test('riskBandCode Punane', () => pm.expect(b.riskBandCode).to.eql('Punane'));",
              "pm.test('riskScore 230', () => pm.expect(parseFloat(b.riskScore)).to.eql(230));",
              "pm.test('totalControls 2', () => pm.expect(b.totalControls).to.eql(2));",
              "pm.test('companyName present', () => pm.expect(b.companyName).to.eql('Riskiskoori Test AS Punane'));"
            ]
          }
        }
      ]
