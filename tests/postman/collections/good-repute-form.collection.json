{
  "info": {
    "name": "LJVIS \u2014 Good Repute Form",
    "_postman_id": "ljvis-good-repute-form-v1",
    "description": "Functional tests for /control-forms/good-repute endpoints (LJVIS2-136). Covers permission boundaries (good_repute_form.write/read), backend validation (required fields, future date, conditional unfit dates + date ordering), UPPERCASE enforcement on text fields, version/status lifecycle (saved -> confirmed, locked-after-confirm, already_confirmed), the saved-state no-version-bump rule, and the edit_locked-gated re-save of confirmed data (officer blocked, admin allowed with version bump). Self-contained: authenticates and creates its own test data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "[Auth] Login \u2014 Super Admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{api_url}}/ljvis/auth/dev/dev-login",
          "host": [
            "{{api_url}}"
          ],
          "path": [
            "ljvis",
            "auth",
            "dev",
            "dev-login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"personalCode\": \"{{pc_admin}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login returns 200', () => pm.response.to.have.status(200));",
              "var body = pm.response.json();",
              "var token = typeof body === 'string' ? body : (body.response || body.token || '');",
              "pm.test('JWT token received', () => pm.expect(token).to.not.be.empty);",
              "pm.environment.set('cookie_admin', 'customJwtCookie=' + token);"
            ]
          }
        }
      ]
    },
