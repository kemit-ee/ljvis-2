        "var body = (raw && typeof raw === 'object' && 'response' in raw) ? (typeof raw.response === 'string' ? JSON.parse(raw.response) : raw.response) : raw;",
        "pm.test('terminationCondition custom value is uppercased', () => pm.expect(body.terminationCondition).to.eql('KUNI ASJAOLUD ARA LANGEVAD'));",
        "pm.test('all 4 legalBases codes stored', () => {",
        "  var bases = JSON.parse(body.legalBases);",
        "  ['autovs_51_lg3_p1','autovs_51_lg3_p2','autovs_51_lg3_p3','autovs_51_lg3_p4'].forEach(code => pm.expect(bases).to.include(code));",
        "});"
      ]}}]
    },
    {
      "name": "POST read/get-by-compound-form-key — happy path, list contains created sub-form",
      "request": {
        "method": "POST",
        "header": [{"key": "Cookie", "value": "{{cookie_admin}}"}, {"key": "Content-Type", "value": "application/json"}],
