{
  "info": {
    "_postman_id": "ljvis-smoke-tests-v1",
    "name": "LJVIS API Smoke Tests",
    "description": "Smoke tests that run directly against resql-users (port 8087) — no auth required.\nFor full integration tests through Ruuter (requires JWT cookie), set the 'mode' variable to 'integration' and provide 'jwt_cookie'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "org_id",   "value": "" },
    { "key": "user_id",  "value": "" },
    { "key": "group_id", "value": "" }
  ],
  "item": [
    {
      "name": "1 — Reference Data",
      "item": [
        {
          "name": "List Organisations",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Response is array', () => pm.expect(Array.isArray(body)).to.be.true);",
                  "pm.test('Has at least one organisation', () => pm.expect(body.length).to.be.above(0));",
                  "if (body.length > 0) {",
                  "  pm.collectionVariables.set('org_id', body[0].id);",
                  "  console.log('org_id set to:', body[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{resql_users_url}}/organisation/list_organisations",
              "host": ["{{resql_users_url}}"],
              "path": ["organisation", "list_organisations"]
            }
          }
        },
        {
          "name": "List Permissions",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Response is array', () => pm.expect(Array.isArray(body)).to.be.true);",
                  "pm.test('Has at least one permission', () => pm.expect(body.length).to.be.above(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{resql_users_url}}/permission/list_permissions",
              "host": ["{{resql_users_url}}"],
              "path": ["permission", "list_permissions"]
            }
          }
        }
      ]
    },
    {
      "name": "2 — Users",
      "item": [
        {
          "name": "List Users (paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Response is array', () => pm.expect(Array.isArray(body)).to.be.true);",
                  "pm.test('Has users from test data', () => pm.expect(body.length).to.be.above(0));",
                  "if (body.length > 0) {",
                  "  const u = body[0];",
                  "  pm.test('User has required fields', () => {",
                  "    pm.expect(u).to.have.property('id');",
                  "    pm.expect(u).to.have.property('first_name');",
                  "    pm.expect(u).to.have.property('last_name');",
                  "    pm.expect(u).to.have.property('status');",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{resql_users_url}}/user/list_users?page=1&page_size=15",
              "host": ["{{resql_users_url}}"],
              "path": ["user", "list_users"],
              "query": [
                { "key": "page",      "value": "1" },
                { "key": "page_size", "value": "15" }
              ]
            }
          }
        },
        {
          "name": "Create Test User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Response is array with one item', () => {",
                  "  pm.expect(Array.isArray(body)).to.be.true;",
                  "  pm.expect(body.length).to.equal(1);",
                  "});",
                  "if (body.length > 0) {",
                  "  pm.collectionVariables.set('user_id', body[0].id);",
                  "  console.log('Created user_id:', body[0].id);",
                  "}"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const orgId = pm.collectionVariables.get('org_id');",
                  "if (!orgId) { throw new Error('org_id not set — run List Organisations first'); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"CI\",\n  \"last_name\": \"TestUser\",\n  \"personal_code\": \"39001010099\",\n  \"organisation_id\": \"{{org_id}}\",\n  \"email\": \"ci.testuser@test.ee\",\n  \"phone\": \"+372 5559999\",\n  \"access_start\": \"2026-01-01\",\n  \"access_end\": \"\"\n}"
            },
            "url": {
              "raw": "{{resql_users_url}}/user/insert_user",
              "host": ["{{resql_users_url}}"],
              "path": ["user", "insert_user"]
            }
          }
        },
        {
          "name": "Get Created User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returns user', () => {",
                  "  pm.expect(Array.isArray(body)).to.be.true;",
                  "  pm.expect(body.length).to.equal(1);",
                  "});",
                  "pm.test('Correct user data', () => {",
                  "  pm.expect(body[0].first_name).to.equal('CI');",
                  "  pm.expect(body[0].last_name).to.equal('TestUser');",
                  "  pm.expect(body[0].personal_code).to.equal('39001010099');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{resql_users_url}}/user/get_user?id={{user_id}}",
              "host": ["{{resql_users_url}}"],
              "path": ["user", "get_user"],
              "query": [{ "key": "id", "value": "{{user_id}}" }]
            }
          }
        },
        {
          "name": "Update Test User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{user_id}}\",\n  \"first_name\": \"CI\",\n  \"last_name\": \"UpdatedUser\",\n  \"personal_code\": \"39001010099\",\n  \"organisation_id\": \"{{org_id}}\",\n  \"email\": \"ci.updated@test.ee\",\n  \"phone\": \"+372 5551111\",\n  \"access_start\": \"2026-01-01\",\n  \"access_end\": \"\"\n}"
            },
            "url": {
              "raw": "{{resql_users_url}}/user/update_user",
              "host": ["{{resql_users_url}}"],
              "path": ["user", "update_user"]
            }
          }
        },
        {
          "name": "Verify Updated User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Last name was updated', () => {",
                  "  pm.expect(body[0].last_name).to.equal('UpdatedUser');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{resql_users_url}}/user/get_user?id={{user_id}}",
              "host": ["{{resql_users_url}}"],
              "path": ["user", "get_user"],
              "query": [{ "key": "id", "value": "{{user_id}}" }]
            }
          }
        }
      ]
    },
    {
      "name": "3 — User Groups",
      "item": [
        {
          "name": "List User Groups",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Response is array', () => pm.expect(Array.isArray(body)).to.be.true);",
                  "pm.test('Has groups from test data', () => pm.expect(body.length).to.be.above(0));",
                  "if (body.length > 0) {",
                  "  pm.collectionVariables.set('group_id', body[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{resql_users_url}}/user_group/list_user_groups",
              "host": ["{{resql_users_url}}"],
              "path": ["user_group", "list_user_groups"]
            }
          }
        },
        {
          "name": "Get User Group",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returns group', () => {",
                  "  pm.expect(Array.isArray(body)).to.be.true;",
                  "  pm.expect(body.length).to.be.above(0);",
                  "});",
                  "pm.test('Group has name', () => pm.expect(body[0]).to.have.property('name'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{resql_users_url}}/user_group/get_user_group?id={{group_id}}",
              "host": ["{{resql_users_url}}"],
              "path": ["user_group", "get_user_group"],
              "query": [{ "key": "id", "value": "{{group_id}}" }]
            }
          }
        },
        {
          "name": "Assign User to Group",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{user_id}}\",\n  \"user_group_id\": \"{{group_id}}\"\n}"
            },
            "url": {
              "raw": "{{resql_users_url}}/user/add_user_group",
              "host": ["{{resql_users_url}}"],
              "path": ["user", "add_user_group"]
            }
          }
        },
        {
          "name": "Verify User Has Group",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('User belongs to at least one group', () => {",
                  "  pm.expect(Array.isArray(body)).to.be.true;",
                  "  pm.expect(body.length).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{resql_users_url}}/user/get_user_groups?user_id={{user_id}}",
              "host": ["{{resql_users_url}}"],
              "path": ["user", "get_user_groups"],
              "query": [{ "key": "user_id", "value": "{{user_id}}" }]
            }
          }
        }
      ]
    },
    {
      "name": "4 — Cleanup",
      "item": [
        {
          "name": "Remove User from Group",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{user_id}}\"\n}"
            },
            "url": {
              "raw": "{{resql_users_url}}/user/remove_all_groups_for_user",
              "host": ["{{resql_users_url}}"],
              "path": ["user", "remove_all_groups_for_user"]
            }
          }
        }
      ]
    }
  ]
}
